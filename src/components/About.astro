---
// About.astro
const education = [
  { years: "2024 – 2027", title: "DEVINE", place: "Howest (Kortrijk)" },
  { years: "2023", title: "Typo logo design", place: "PROJECTOR online institute" },
  { years: "2022 – 2023", title: "Graphic design", place: "PROJECTOR online institute" },
];

const skillGroups = [
  {
    label: "Design & Experience",
    items: [
      "UI Design",
      "UX Research",
      "Interaction Design",
      "Visual Design",
      "Prototyping",
      "Design Systems",
      "Visual Storytelling",
      "Motion design",
    ],
  },

  {
    label: "Development & Creative Tech",
    items: [
      "HTML / CSS",
      "JavaScript",
      "Responsive Web",
      "Creative Coding",
      "Interactive Prototyping",
      "Data Visualisation",
      "AI-assisted Workflows",
    ],
  },

  {
    label: "Process",
    items: [
      "Concepting",
      "User Research",
      "Ideation",
      "Testing & Iteration",
      "Presenting",
      "Teamwork",
      "Project Planning",
    ],
  },

  {
    label: "Tools",
    items: [
      "Figma",
      "Adobe Ps / Ai / Id / Ae",
      "Git / GitHub",
      "VS Code",
      "Blender",
    ],
  },

  {
    label: "Languages",
    items: [
      "English — C1",
      "Ukranian — Native",
      "Russian — Native",
      "French — A2 (in progress)",
      "Dutch — A1 (in progress)",
      "German — A1"
    ],
  },
];
---

<section class="about" id="about">
  <div class="about-header">
    <h2 class="about-heading">About me</h2>
    <span class="about-tag">#about</span>
  </div>

  <div class="about-grid">
    <div class="card bio-card">
      <p>
        I'm a digital designer and developer with a background in graphic and type design, currently in my third year of Digital Design and Development (Devine) at Howest.
      </p>
      <p>
        My focus is experience and visual design: interfaces, interaction, motion and visual systems. I'm most excited by projects where research, identity and product come together, and by typography, which I keep exploring through smaller experiments.
      </p>
      <p>
        I care about quality, both in how a project looks and in how it's made. I want every project to be 100% good for the client, and something I'm proud of myself. That means paying attention to the details, testing ideas early and not stopping at “good enough”.
      </p>

      <span class="card-label">Education</span>
      <ul class="timeline">
        {education.map((entry) => (
          <li>
            <span class="timeline-years">{entry.years}</span>
            <span class="timeline-content">
              <strong>{entry.title}</strong>
              <span class="timeline-place">{entry.place}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="skills-column">
      {skillGroups.map((group) => (
        <div class="card">
          <span class="card-label">{group.label}</span>
          <div class="pills">
            {group.items.map((item) => <span class="pill">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    background: #ffffff;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    font-family: system-ui, -apple-system, sans-serif; 
    color: #1a1a1a;
  }

  .about-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .about-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .about-tag {
    color: #9a9a9a;
    font-size: 0.9rem;
    font-family: monospace;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card {
    background: #f4f4f4;
    border-radius: 1.5rem;
    padding: 1.75rem;
  }
  .bio-card {
  align-self: start;
}
  .bio-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1.25rem;
  }

  .card-label {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0;
  }

  .timeline-years {
    font-weight: 700;
    color: #888;
    font-size: 0.9rem;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-content strong {
    font-size: 1rem;
  }

  .timeline-place {
    color: #888;
    font-size: 0.85rem;
  }

  .skills-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .pill {
    background: #e9e9e9;
    color: #333;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* Desktop — two-column layout, timeline goes side-by-side */
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }

    .timeline li {
      flex-direction: row;
      align-items: baseline;
      gap: 1.5rem;
    }

    .timeline-years {
      flex: 0 0 100px;
    }
  }
</style>
