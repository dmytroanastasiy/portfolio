---
// Experiments.astro
// Draft placeholders — swap each card's content for a real experiment
// (image, title, short description, tag) when it's ready.
const experiments = [
  { index: "01" },
  { index: "02" },
  { index: "03" },
];
---

<section class="experiments" id="experiments">
  <div class="experiments-header">
    <h2 class="experiments-heading">Experiments</h2>
    <span class="experiments-tag">#experiments</span>
  </div>

  <ul class="experiments-list">
    {experiments.map((item) => (
      <li class="experiment-card">
        <span class="experiment-index">{item.index}</span>

        <div class="experiment-media">
          <svg
            class="media-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="3" y="3" width="18" height="18" rx="1" />
            <circle cx="8.5" cy="9.5" r="1.5" />
            <path d="M21 15l-5-5-9 9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>add image</span>
        </div>

        <h3 class="experiment-title">Experiment title</h3>
        <p class="experiment-desc">One or two lines about what this explores.</p>
        <span class="experiment-tag">tag</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .experiments {
    background: #0d0d0d;
    color: #ffffff;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .experiments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .experiments-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .experiments-tag {
    color: #444;
    font-size: 0.9rem;
    font-family: monospace;
  }

  .experiments-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experiment-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px dashed rgba(255, 255, 255, 0.25);
  }

  .experiment-index {
    font-family: monospace;
    color: #555;
    font-size: 0.85rem;
  }

  .experiment-media {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px dashed rgba(255, 255, 255, 0.25);
    color: #555;
    font-size: 0.8rem;
  }

  .media-icon {
    width: 28px;
    height: 28px;
  }

  .experiment-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #777;
    margin: 0;
  }

  .experiment-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }

  .experiment-tag {
    align-self: flex-start;
    background: #1c1c1c;
    color: #777;
    padding: 0.3rem 0.8rem;
    font-size: 0.75rem;
  }

  /* Desktop — three cards in a row */
  @media (min-width: 768px) {
    .experiments-list {
      flex-direction: row;
    }

    .experiment-card {
      flex: 1;
    }
  }
</style>
