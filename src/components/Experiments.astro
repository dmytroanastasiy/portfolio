---
// Experiments.astro
// Cards open a detail modal (like the "Playground & experiments" reference).
// Add more items to `experiments` — each needs either `video` or `image`.
const base = import.meta.env.BASE_URL;

const experiments = [
  {
    id: "puplet",
    label: "Howest",
    year: "2026",
    title: "Puplet — Kickstarter film",
    summary: "An animated launch film for an all-in-one paw washer.",
    description:
      "A promotion animation for a Kickstarter campaign. Every walk ends with muddy paws - and every dog owner knwos this bath & towel routine. Puplet turns cleaning into a quick and easy moment of care. Animation introduces the 4-in-1 product through playfully illustrated scenes. IlluA promotion animation for a Kickstarter campaign. Every walk ends with muddy paws — and every dog owner knows this bath & towel routine. Puplet turns cleaning into a quick and easy moment of care. The animation introduces the 4-in-1 product through playful illustrated scenes. My personal experiment here was to animate people and animals, which made me explore and execute new techniques. Illustrated in Illustrator and animated in After Effects, using Audition to work with sound & music.",
    tags: ["Motion Design", "Storytelling", "Illustration"],
    video: `${base}experiments/puplet-kickstarter.mp4`,
    poster: `${base}experiments/puplet-kickstarter-poster.avif`,
    image: `${base}experiments/puplet-cover.avif`,
  },
  {
    id: "dress-to-impress",
    label: "MoMu × Howest",
    year: "2026",
    title: "Dress to Impress",
    summary: "An interactive scroll story on Walter Van Beirendonck’s fashion as activism",
    description:
      "A digital exhibition for MoMu about Walter Van Beirendonck and how he addresses crises through fashion, from the AIDS epidemic to the damage we're doing to our planet. My attention was drawn to his message that never changed, and he translated in through his work so much times: caring for a person and caring for the planet are the same thing. As a designer and developer, I didn't want to squeeze him into a clean, safe template. Walter is loud, provocative and one of a kind, so I made the design rough, bold and weird to match him. ",
    tags: ["Interactive Story", "Design", "Scrollytelling", "Web Development"],
    link: "https://dmytroanastasiy.github.io/integration3/",
    cover: {
      kicker: "Walter Van Beirendonck",
      title: "Dress to Impress",
      note: "Care is the same whether you are holding a person or a planet.",
    },
    image: `${base}experiments/dress-to-impress.avif`,
  },
  {
    id: "le-labo",
    label: "Le Labo × Howest",
    year: "2026",
    title: "Le Labo — 3D hero",
    summary: "An animated 3D header for Le Labo’s website, modelled in Blender for desktop and mobile.",
    description:
      "A proposal for Le Labo, pitched the way a design agency would: the client had heard that 3D is the next big thing on the web and wanted it on their site as a promotional hero, with a clear visual concept, not necessarily photorealistic, and never static. Le Labo’s whole identity is the lab. Every bottle is mixed by hand in the store and labelled with the date and the city it was made in. So I turned the header into a perfumer’s workbench, a small diorama where the bottles sit among their raw materials: wood, rose petals and loose tea leaves next to Santal 33, Rose 31 and Thé Matcha 26. The animation is what brings it to life: a bottle tips over, a cap pops off and rolls across the mat, drops of oil catch the light. For mobile I built a separate vertical scene around a lab stand, so the phone gets its own hero instead of a cropped landscape one. Modelled, lit and animated in Blender, then placed into the Le Labo site to show how it would live in context.",
    tags: ["3D", "Blender", "Motion Design", "Web Design"],
    cardVideo: `${base}experiments/lelabo-card.mp4`,
    cardPoster: `${base}experiments/lelabo-card.webp`,
    films: [
      {
        device: "desktop",
        name: "Desktop",
        clips: [
          { label: "On the website", src: "lelabo-desktop-site", ratio: 16 / 9 },
          { label: "Render", src: "lelabo-desktop-render", ratio: 16 / 9 },
          { label: "On the website", image: "lelabo-desktop-site-still", ratio: 1470 / 830 },
          { label: "Render", image: "lelabo-desktop-render-still", ratio: 16 / 9 },
        ],
      },
      {
        device: "mobile",
        name: "Mobile",
        clips: [
          { label: "On the website", src: "lelabo-mobile-site", ratio: 584 / 1196, phone: true },
          { label: "Render", src: "lelabo-mobile-render", ratio: 4 / 5 },
          { label: "On the website", image: "lelabo-mobile-site-still", ratio: 414 / 847, phone: true },
          { label: "Render", image: "lelabo-mobile-render-still", ratio: 4 / 5 },
        ],
      },
    ],
  },
];

const film = (name) => `${base}experiments/${name}.mp4`;
const filmPoster = (name) => `${base}experiments/${name}.webp`;
const still = (name) => `${base}experiments/${name}.webp`;

const shot = (name) => `${base}experiments/${name}.jpg`;
---

<section class="experiments" id="experiments">
  <div class="experiments-header">
    <h2 class="experiments-heading">Experiments</h2>
    <span class="experiments-tag">#experiments</span>
  </div>

  <ul class="experiments-grid">
    {experiments.map((item) => (
      <li>
        <button class="exp-card" type="button" data-exp-open={item.id} aria-haspopup="dialog">
          <div class="exp-card__media">
            {item.cardVideo ? (
              <video
                src={item.cardVideo}
                poster={item.cardPoster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
            ) : item.video && item.image ? (
              <img class="exp-card__cover" src={item.image} alt="" loading="lazy" />
            ) : item.screens && typeof item.cover === "string" ? (
              <img class="exp-card__cover" src={item.cover} alt="" loading="lazy" />
            ) : item.screens ? (
              <div class="device-cover" aria-hidden="true">
                <div class="device-cover__browser">
                  <div class="device-bar"><i></i><i></i><i></i></div>
                  <img src={shot(item.screens[0].desktop)} alt="" loading="lazy" />
                </div>
                <div class="device-cover__phone">
                  <div><img src={shot(item.screens[0].mobile)} alt="" loading="lazy" /></div>
                </div>
              </div>
            ) : item.video ? (
              <video
                src={item.video}
                poster={item.poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
            ) : item.image ? (
              <img src={item.image} alt="" loading="lazy" />
            ) : (
              <div class="exp-cover" aria-hidden="true">
                <span class="exp-cover__kicker">{item.cover.kicker}</span>
                <span class="exp-cover__title">{item.cover.title}</span>
                <span class="exp-cover__note">{item.cover.note}</span>
              </div>
            )}
          </div>

          <div class="exp-card__body">
            <div class="exp-card__meta">
              <span>{item.label}</span>
              <span>{item.year}</span>
            </div>
            <h3 class="exp-card__title">{item.title}</h3>
            <p class="exp-card__summary">{item.summary}</p>
            <div class="exp-tags">
              {item.tags.map((tag) => <span class="exp-tag">{tag}</span>)}
            </div>
          </div>
        </button>

        <dialog
          class:list={["exp-modal", { "exp-modal--deck": item.films }]}
          data-exp-modal={item.id}
          data-screens={item.films ? "" : undefined}
          aria-label={item.title}
        >
          {item.films && (
            <div class="deck-bar">
              <div class="screens__switch" role="tablist" aria-label="Device">
                {item.films.map((f, i) => (
                  <button class:list={{ "is-on": i === 0 }} type="button" data-device={f.device}>{f.name}</button>
                ))}
              </div>
              <button class="exp-modal__close" type="button" data-exp-close aria-label="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>
          )}

          <div class={item.screens || item.films ? "exp-modal__media exp-modal__media--screens" : "exp-modal__media"}>
            {item.films ? (
              item.films.map((f, i) => (
                <div
                  class:list={["screens__view", "deck", `deck--${f.device}`, { "is-on": i === 0 }]}
                  data-view={f.device}
                  data-deck
                  style={`--count: ${f.clips.length}`}
                >
                  <div class="deck__stage">
                    <div class="deck__cards">
                      {f.clips.map((clip, n) => (
                        <figure
                          class:list={["deck__card", { "deck__card--phone": clip.phone }]}
                          data-card
                          style={`--ratio: ${clip.ratio}; z-index: ${f.clips.length - n}`}
                        >
                          {clip.image ? (
                            <img
                              src={still(clip.image)}
                              alt={`${item.title} — ${clip.label}, ${f.name.toLowerCase()} still`}
                              loading="lazy"
                            />
                          ) : (
                            <video
                              data-film
                              src={film(clip.src)}
                              poster={filmPoster(clip.src)}
                              muted
                              loop
                              playsinline
                              preload="none"
                              aria-label={`${item.title} — ${clip.label}, ${f.name.toLowerCase()} animation`}
                            ></video>
                          )}
                          <figcaption class="deck__chip">
                            {clip.label}
                            <span>{clip.image ? "Still" : "Animated"}</span>
                          </figcaption>
                        </figure>
                      ))}
                    </div>

                    <div class="deck__foot">
                      <div class="deck__dots" aria-hidden="true">
                        {f.clips.map((_, n) => <i class:list={{ "is-on": n === 0 }}></i>)}
                      </div>
                      <span class="deck__count" data-deck-count>1 / {f.clips.length}</span>
                      <span class="deck__hint" data-deck-hint>Scroll to flip through</span>
                    </div>
                  </div>
                </div>
              ))
            ) : item.screens ? (
              <div class="screens" data-screens>
                <div class="screens__switch" role="tablist" aria-label="Device">
                  <button class="is-on" type="button" data-device="desktop">Desktop</button>
                  <button type="button" data-device="mobile">Mobile</button>
                </div>

                <div class="screens__view is-on" data-view="desktop">
                  <div class="screens__browser">
                    <div class="device-bar"><i></i><i></i><i></i></div>
                    {item.screens.map((sc, i) => (
                      <div class:list={["screens__scroll", { "is-on": i === 0 }]} data-page={i}>
                        <img src={shot(sc.desktop)} alt={`${item.title} — ${sc.name} page, desktop`} loading="lazy" />
                      </div>
                    ))}
                  </div>

                  <div class="screens__pager">
                    <button type="button" data-step="-1" aria-label="Previous page">‹</button>
                    <span data-page-name>{item.screens[0].name}</span>
                    <div class="screens__dots">
                      {item.screens.map((sc, i) => <i class:list={{ "is-on": i === 0 }} data-name={sc.name}></i>)}
                    </div>
                    <button type="button" data-step="1" aria-label="Next page">›</button>
                  </div>
                  <p class="screens__hint">Scroll inside the page to see it in full</p>
                </div>

                <div class="screens__view" data-view="mobile">
                  <div class="screens__phones">
                    {item.screens.map((sc) => (
                      <div class="screens__phone">
                        <div class="screens__frame">
                          <div class="screens__phone-scroll">
                            <img src={shot(sc.mobile)} alt={`${item.title} — ${sc.name} page, mobile`} loading="lazy" />
                          </div>
                        </div>
                        <span>{sc.name}</span>
                      </div>
                    ))}
                  </div>
                  <p class="screens__hint">Scroll inside each screen</p>
                </div>
              </div>
            ) : item.video ? (
              <video
                src={item.video}
                poster={item.poster}
                controls
                playsinline
                preload="none"
              ></video>
            ) : item.image ? (
              <img src={item.image} alt={item.title} loading="lazy" />
            ) : (
              <div class="exp-cover exp-cover--large" aria-hidden="true">
                <span class="exp-cover__kicker">{item.cover.kicker}</span>
                <span class="exp-cover__title">{item.cover.title}</span>
                <span class="exp-cover__note">{item.cover.note}</span>
              </div>
            )}
            {!item.films && (
              <button class="exp-modal__close" type="button" data-exp-close aria-label="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            )}
          </div>

          <div class="exp-modal__body">
            <div class="exp-modal__meta">
              <span>{item.label}</span>
              <span>{item.year}</span>
            </div>
            <h3 class="exp-modal__title">{item.title}</h3>
            <p class="exp-modal__desc">{item.description}</p>
            <div class="exp-tags exp-tags--light">
              {item.tags.map((tag) => <span class="exp-tag">{tag}</span>)}
            </div>
            {item.link && (
              <a class="exp-modal__link" href={item.link} target="_blank" rel="noopener noreferrer">
                {item.linkLabel ?? "Visit project"} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </dialog>
      </li>
    ))}
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-exp-open]").forEach((card) => {
    const id = card.dataset.expOpen;
    const modal = document.querySelector<HTMLDialogElement>(`[data-exp-modal="${id}"]`);
    if (!modal) return;
    const video = modal.querySelector<HTMLVideoElement>("video:not([data-film])");
    const films = modal.querySelectorAll<HTMLVideoElement>("video[data-film]");

    const pauseAll = () => {
      video?.pause();
      films.forEach((f) => f.pause());
    };

    const close = () => {
      pauseAll();
      modal.close();
    };

    card.addEventListener("click", () => {
      modal.showModal();
      modal.scrollTop = 0;
      if (video) {
        video.currentTime = 0;
        video.muted = false;
        video.play().catch(() => {});
      }
      modal.querySelectorAll<HTMLVideoElement>("[data-view].is-on video[data-film]").forEach((f) => {
        f.currentTime = 0;
        f.play().catch(() => {});
      });
    });

    modal.querySelector("[data-exp-close]")?.addEventListener("click", close);

    // Click on the dimmed backdrop closes the modal.
    modal.addEventListener("click", (event) => {
      if (event.target === modal) close();
    });

    modal.addEventListener("cancel", pauseAll);
  });

  /* Card deck: scrolling the modal flips through the stacked cards.
     Cards behind the front one stay rotated, scaled down and blurred
     until scroll brings them forward. */
  document.querySelectorAll<HTMLElement>("[data-deck]").forEach((deck) => {
    const modal = deck.closest("dialog");
    if (!modal) return;
    const stage = deck.querySelector<HTMLElement>(".deck__stage")!;
    const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
    const dots = [...deck.querySelectorAll<HTMLElement>(".deck__dots i")];
    const count = deck.querySelector("[data-deck-count]");
    const hint = deck.querySelector<HTMLElement>("[data-deck-hint]");
    const last = cards.length - 1;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const place = (card: HTMLElement, d: number) => {
      let transform: string;
      let opacity: number;
      let blur = 0;
      if (d < 0) {
        // Front card leaving: slides up and tilts away.
        const k = Math.max(d, -1);
        transform = `translate3d(0, ${k * 115}%, 0) rotate(${-k * 7}deg)`;
        opacity = clamp(1 + (k + 0.25) * 2.2, 0, 1);
      } else {
        // Waiting in the stack: offset up-left, rotated, smaller, blurred.
        const k = Math.min(d, 3);
        transform = `translate3d(${-k * 7}%, ${-k * 8}%, 0) rotate(${-k * 6}deg) scale(${1 - k * 0.05})`;
        opacity = clamp(1 - k * 0.3, 0, 1);
        blur = reduced ? 0 : Math.min(k, 2) * 6;
      }
      card.style.transform = transform;
      card.style.opacity = String(opacity);
      card.style.filter = blur > 0.2 ? `blur(${blur.toFixed(1)}px)` : "none";
      card.classList.toggle("is-front", Math.abs(d) < 0.5);
    };

    const update = () => {
      if (!deck.offsetParent) return; // hidden device view
      const range = deck.offsetHeight - stage.offsetHeight;
      const scrolled = modal.getBoundingClientRect().top - deck.getBoundingClientRect().top;
      const progress = range > 0 ? clamp(scrolled / range, 0, 1) * last : 0;
      cards.forEach((card, i) => place(card, i - progress));
      const active = Math.round(progress);
      dots.forEach((dot, i) => dot.classList.toggle("is-on", i === active));
      if (count) count.textContent = `${active + 1} / ${cards.length}`;
      hint?.classList.toggle("is-gone", progress > 0.15);
    };

    modal.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    // Fires when the modal opens or this device view is shown.
    new ResizeObserver(update).observe(deck);
    update();
  });

  /* Desktop / mobile screen viewer */
  document.querySelectorAll<HTMLElement>("[data-screens]").forEach((viewer) => {
    const deviceButtons = viewer.querySelectorAll<HTMLButtonElement>("[data-device]");
    const views = viewer.querySelectorAll<HTMLElement>("[data-view]");
    deviceButtons.forEach((btn) =>
      btn.addEventListener("click", () => {
        if (viewer instanceof HTMLDialogElement) viewer.scrollTop = 0; // restart the deck
        deviceButtons.forEach((b) => b.classList.toggle("is-on", b === btn));
        views.forEach((v) => {
          const on = v.dataset.view === btn.dataset.device;
          v.classList.toggle("is-on", on);
          // Only the visible device's films play.
          v.querySelectorAll<HTMLVideoElement>("video[data-film]").forEach((f) => {
            if (on) {
              f.currentTime = 0;
              f.play().catch(() => {});
            } else {
              f.pause();
            }
          });
        });
      })
    );

    const pages = viewer.querySelectorAll<HTMLElement>("[data-page]");
    const dots = viewer.querySelectorAll<HTMLElement>(".screens__dots i");
    const label = viewer.querySelector("[data-page-name]");
    let index = 0;
    const show = (i: number) => {
      index = (i + pages.length) % pages.length;
      pages.forEach((p, n) => p.classList.toggle("is-on", n === index));
      dots.forEach((d, n) => d.classList.toggle("is-on", n === index));
      pages[index].scrollTop = 0;
      if (label) label.textContent = dots[index]?.dataset.name ?? "";
    };
    viewer.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => show(index + Number(b.dataset.step)))
    );
  });
</script>

<style>
  .experiments {
    background: #ffffff;
    color: #111111;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .experiments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .experiments-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .experiments-tag {
    color: #9a9a9a;
    font-size: 0.9rem;
    font-family: monospace;
  }

  /* ---------- Grid ---------- */

  .experiments-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .experiments-grid > li {
    min-width: 0;
  }

  /* ---------- Card ---------- */

  .exp-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #f4f4f4;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .exp-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
  }

  .exp-card:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  .exp-card__media {
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #222;
  }

  .exp-card__media img,
  .exp-modal__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-modal__media img {
    height: auto;
  }

  .exp-card__media img {
    object-position: center;
  }

  /* Typographic cover for projects without an image yet */
  .exp-cover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    padding: 1.25rem 1.5rem;
    background: #f3efe8;
    color: #111;
  }

  .exp-cover__kicker {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a7a64;
  }

  .exp-cover__title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .exp-cover__note {
    max-width: 22rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: #6b6b6b;
  }

  .exp-cover--large {
    aspect-ratio: 16 / 9;
    padding: 2.5rem;
  }

  .exp-cover--large .exp-cover__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
  }

  .exp-modal__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .exp-card__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.5rem 1.6rem 1.7rem;
  }

  .exp-card__meta,
  .exp-modal__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: #8a8a8a;
  }

  .exp-card__title {
    margin: 0;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .exp-card__summary {
    margin: 0;
    color: #666;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.4rem;
  }

  .exp-tag {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: #e9e9e9;
    color: #333;
    font-size: 0.78rem;
  }

  /* ---------- Modal ---------- */

  .exp-modal {
    width: min(92vw, 40rem);
    max-height: 90vh;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    overflow: auto;
    background: #fff;
