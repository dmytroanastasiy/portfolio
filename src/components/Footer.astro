---
// Footer.astro — contact block + footer line.
const email = "dmytro.anastasiy@student.howest.be";
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Email", value: email, href: `mailto:${email}` },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/dmytro-anastasiy",
    href: "https://www.linkedin.com/in/dmytro-anastasiy-b14a24386/",
  },
  {
    label: "Behance",
    value: "behance.net/dmytroanastasiy",
    href: "https://www.behance.net/dmytroanastasiy",
  },
  {
    label: "Résumé",
    value: "Download CV (PDF)",
    href: `${base}Dmytro_Anastasiy-CV.pdf`,
    download: "Dmytro Anastasiy — CV.pdf",
  },
];

const year = new Date().getFullYear();
---

<footer class="contact" id="contact">
  <div class="contact-top">
    <span class="mono">Contact</span>
    <span class="mono contact-status"><i aria-hidden="true"></i>Open to work</span>
  </div>

  <a class="contact-big" href={`mailto:${email}`}>
    <span class="contact-big__line">Let’s work</span>
    <span class="contact-big__line contact-big__line--accent">together.</span>
    <span class="contact-big__cta mono">Get in touch ↗</span>
  </a>

  <ul class="contact-links">
    {links.map((link) => (
      <li>
        <a
          class="contact-link"
          href={link.href}
          target={link.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
          download={link.download}
        >
          <span class="contact-link__label mono">{link.label}</span>
          <span class="contact-link__value">{link.value}</span>
          <span class="contact-link__arrow" aria-hidden="true">{link.download ? "↓" : "↗"}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="contact-bottom">
    <span class="mono">Dmytro Anastasiy — Digital Designer &amp; Developer</span>
    <span class="mono">Designed &amp; built by me · © {year}</span>
  </div>
</footer>

<style>
  .contact {
    background: #0a0a0a;
    color: #f5f5f5;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .mono {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: #6f6f78;
  }

  .contact-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-status i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    70% { box-shadow: 0 0 0 0.45rem rgba(61, 220, 132, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); }
  }

  /* Big headline — same type as the hero (Inter, tight tracking) */
  .contact-big {
    position: relative;
    display: block;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    color: inherit;
    text-decoration: none;
  }

  .contact-big__line {
    display: block;
    font-size: clamp(3.5rem, 10.5vw, 10rem);
    font-weight: 550;
    line-height: 0.9;
    letter-spacing: -0.075em;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-big__line--accent {
    color: #6f6f78;
    transition: color 0.4s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-big:hover .contact-big__line {
    transform: translateX(0.6rem);
  }

  .contact-big:hover .contact-big__line--accent {
    color: #ffffff;
  }

  .contact-big__cta {
    position: absolute;
    right: 0;
    bottom: clamp(2.5rem, 6vw, 4.5rem);
    color: #d6d6d6;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  /* Link rows */
  .contact-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contact-link {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: inherit;
    text-decoration: none;
  }

  .contact-link__value {
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    letter-spacing: -0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: transform 0.35s ease;
  }

  .contact-link__arrow {
    font-size: 1.2rem;
    color: #6f6f78;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .contact-link:hover .contact-link__value {
    transform: translateX(0.5rem);
  }

  .contact-link:hover .contact-link__arrow {
    color: #ffffff;
    transform: translate(0.2rem, -0.2rem);
  }

  .contact-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (max-width: 700px) {
    .contact-big__cta {
      position: static;
      display: inline-block;
      margin-top: 1.5rem;
    }

    .contact-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }

    .contact-link__label {
      grid-column: 1 / -1;
    }

    .contact-bottom {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-status i { animation: none; }
  }
</style>
