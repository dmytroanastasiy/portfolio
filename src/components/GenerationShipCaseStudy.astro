<script>
  const buttons =
    document.querySelectorAll(".reading-mode__button");

  const fullSections =
    document.querySelectorAll(".full-process");

  function setReadingMode(mode) {
    buttons.forEach((button) => {
      button.classList.toggle(
        "is-active",
        button.dataset.mode === mode
      );
    });

    fullSections.forEach((section) => {
      section.classList.toggle(
        "is-hidden",
        mode === "quick"
      );
    });
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      setReadingMode(button.dataset.mode);
    });
  });

  setReadingMode("quick");


  /* ==========================================
     DRAGGABLE + ZOOMABLE PROCESS IMAGES

     This version does NOT use scrollLeft / scrollWidth for panning.
     The image itself is translated and scaled, and the drag limits are
     recalculated from the CURRENT zoomed image size on every move.
  ========================================== */

  const draggableMedia =
    document.querySelectorAll<HTMLElement>("[data-drag-scroll]");

  draggableMedia.forEach((viewport) => {
    const image =
      viewport.querySelector<HTMLImageElement>(".media-pan__image");

    if (!image) return;

    let baseWidth = 0;
    let baseHeight = 0;

    let zoom = 1;
    let panX = 0;
    let panY = 0;

    let isDragging = false;
    let lastPointerX = 0;
    let lastPointerY = 0;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 5;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const captureBaseSize = () => {
      if (baseWidth && baseHeight) return;

      baseWidth = image.offsetWidth;
      baseHeight = image.offsetHeight;
    };

    const getBounds = () => {
      captureBaseSize();

      const viewportWidth = viewport.clientWidth;
      const viewportHeight = viewport.clientHeight;

      const scaledWidth = baseWidth * zoom;
      const scaledHeight = baseHeight * zoom;

      /*
        If the zoomed image is smaller than the viewport on an axis,
        lock it to the centre on that axis.

        If it is larger, allow movement all the way from one edge
        to the other.
      */
      const minX =
        scaledWidth <= viewportWidth
          ? (viewportWidth - scaledWidth) / 2
          : viewportWidth - scaledWidth;

      const maxX =
        scaledWidth <= viewportWidth
          ? (viewportWidth - scaledWidth) / 2
          : 0;

      const minY =
        scaledHeight <= viewportHeight
          ? (viewportHeight - scaledHeight) / 2
          : viewportHeight - scaledHeight;

      const maxY =
        scaledHeight <= viewportHeight
          ? (viewportHeight - scaledHeight) / 2
          : 0;

      return {
        minX,
        maxX,
        minY,
        maxY,
      };
    };

    const clampPan = () => {
      const bounds = getBounds();

      panX = clamp(panX, bounds.minX, bounds.maxX);
      panY = clamp(panY, bounds.minY, bounds.maxY);
    };

    const render = () => {
      clampPan();

      image.style.transform =
        `translate3d(${panX}px, ${panY}px, 0) scale(${zoom})`;

      viewport.classList.toggle("is-zoomed", zoom > 1);
    };

    const centreImage = () => {
      captureBaseSize();

      const scaledWidth = baseWidth * zoom;
      const scaledHeight = baseHeight * zoom;

      panX =
        (viewport.clientWidth - scaledWidth) / 2;

      panY =
        (viewport.clientHeight - scaledHeight) / 2;

      render();
    };

    const setZoom = (
      nextZoom: number,
      clientX?: number,
      clientY?: number
    ) => {
      captureBaseSize();

      const rect = viewport.getBoundingClientRect();

      const anchorX =
        clientX ?? rect.left + rect.width / 2;

      const anchorY =
        clientY ?? rect.top + rect.height / 2;

      const localX =
        anchorX - rect.left;

      const localY =
        anchorY - rect.top;

      /*
        Work out which point INSIDE the image is currently under the
        mouse / trackpad position.
      */
      const imageX =
        (localX - panX) / zoom;

      const imageY =
        (localY - panY) / zoom;

      const newZoom =
        clamp(nextZoom, MIN_ZOOM, MAX_ZOOM);

      if (newZoom === zoom) return;

      zoom = newZoom;

      /*
        Reposition the image so the same image point remains underneath
        the pointer after zooming.
      */
      panX =
        localX - imageX * zoom;

      panY =
        localY - imageY * zoom;

      render();
    };

    const initialise = () => {
      captureBaseSize();
      centreImage();
    };

    if (image.complete) {
      initialise();
    } else {
      image.addEventListener(
        "load",
        initialise,
        { once: true }
      );
    }


    /* ------------------------------------------
       DRAG / PAN
    ------------------------------------------ */

    viewport.addEventListener("pointerdown", (event) => {
      if (
        event.pointerType === "mouse" &&
        event.button !== 0
      ) {
        return;
      }

      isDragging = true;

      lastPointerX = event.clientX;
      lastPointerY = event.clientY;

      viewport.classList.add("is-dragging");

      viewport.setPointerCapture?.(
        event.pointerId
      );
    });

    viewport.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      const deltaX =
        event.clientX - lastPointerX;

      const deltaY =
        event.clientY - lastPointerY;

      lastPointerX = event.clientX;
      lastPointerY = event.clientY;

      /*
        Dragging directly updates the image translation.
        The limits below are based on the CURRENT zoom level.
      */
      panX += deltaX;
      panY += deltaY;

      render();
    });

    const stopDragging = (event) => {
      if (!isDragging) return;

      isDragging = false;
      viewport.classList.remove("is-dragging");

      if (
        viewport.hasPointerCapture?.(
          event.pointerId
        )
      ) {
        viewport.releasePointerCapture(
          event.pointerId
        );
      }
    };

    viewport.addEventListener(
      "pointerup",
      stopDragging
    );

    viewport.addEventListener(
      "pointercancel",
      stopDragging
    );

    viewport.addEventListener(
      "lostpointercapture",
      () => {
        isDragging = false;
        viewport.classList.remove(
          "is-dragging"
        );
      }
    );


    /* ------------------------------------------
       ZOOM
    ------------------------------------------ */

    viewport.addEventListener(
      "wheel",
      (event) => {
        const wantsZoom =
          event.ctrlKey ||
          event.metaKey ||
          event.altKey;

        if (!wantsZoom) return;

        event.preventDefault();

        const factor =
          Math.exp(-event.deltaY * 0.01);

        setZoom(
          zoom * factor,
          event.clientX,
          event.clientY
        );
      },
      { passive: false }
    );

    viewport.addEventListener(
      "dblclick",
      (event) => {
        event.preventDefault();

        setZoom(
          zoom > 1 ? 1 : 1.5,
          event.clientX,
          event.clientY
        );

        if (zoom === 1) {
          centreImage();
        }
      }
    );


    /* ------------------------------------------
       KEYBOARD
    ------------------------------------------ */

    if (!viewport.hasAttribute("tabindex")) {
      viewport.tabIndex = 0;
    }

    viewport.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "+" ||
          event.key === "="
        ) {
          event.preventDefault();
          setZoom(zoom * 1.2);
        }

        if (event.key === "-") {
          event.preventDefault();
          setZoom(zoom / 1.2);
        }

        if (event.key === "0") {
          event.preventDefault();

          zoom = 1;
          centreImage();
        }
      }
    );


    /* ------------------------------------------
       RESPONSIVE
    ------------------------------------------ */

    window.addEventListener("resize", () => {
      render();
    });
  });
</script>


<script>
  /* Process index adapts to Quick read / Full process:
     hides links to sections that are hidden and renumbers the rest
     (index card + section number stay in sync). */
  const indexLinks = [...document.querySelectorAll(".process-index a")];

  indexLinks.forEach((link) => {
    const target = document.querySelector(link.getAttribute("href"));
    const num = link.querySelector("span");
    const secNum = target?.querySelector(":scope > .section-number");
    link._target = target;
    link._num = num;
    link._secNum = secNum;
    link._orig = num?.textContent;
    if (secNum) secNum.dataset.orig = secNum.textContent;
  });

  function syncProcessIndex() {
    let n = 0;
    indexLinks.forEach((link) => {
      const hidden = !link._target || link._target.classList.contains("is-hidden");
      link.hidden = hidden;
      if (hidden) return;
      n += 1;
      const label = String(n).padStart(2, "0");
      if (link._num) link._num.textContent = label;
      if (link._secNum) link._secNum.textContent = label;
    });
  }

  // Re-sync whenever a section is shown/hidden by the reading-mode toggle
  const indexObserver = new MutationObserver(syncProcessIndex);
  indexLinks.forEach((link) => {
    if (link._target) indexObserver.observe(link._target, { attributes: true, attributeFilter: ["class"] });
  });

  syncProcessIndex();
</script>

