---

import CaseProgressNav from "./CaseProgressNav.astro";


const {
  title = "Safety Without Excessive Monitoring",
  year = "2026",
  type = "Experience Design · Speculative UX",
  role = "Team project",
} = Astro.props;

const behanceUrl = "https://www.behance.net/dmytroanastasiy";
const figjamUrl = "https://www.figma.com/board/6zOfQVcsnaR8cxzSV8rmt4/XD4-ENG-Team-14?node-id=39-555&t=r6yov2Sjw6FH29l4-1";

const processSteps = [
  "The tension",
  "The system",
  "From question to concept",
  "Testing",
  "Iteration",
  "Final experience",
  "Ethical design",
  "Outcome",
];

const principles = [
  {
    number: "01",
    title: "Minimum data by default",
    text: "The system should collect only what is necessary for safety, rather than treating constant monitoring as the default.",
  },
  {
    number: "02",
    title: "Consent before additional tracking",
    text: "Additional information should require a clear reason and an explicit choice from the person involved.",
  },
  {
    number: "03",
    title: "Transparent data use",
    text: "People should understand what is being collected, why it is needed and how it affects them.",
  },
  {
    number: "04",
    title: "Private reputation",
    text: "Reputation can support trust without becoming a public score or a mechanism for social punishment.",
  },
  {
    number: "05",
    title: "Moderation without punishment",
    text: "The system should support conflict resolution and community safety rather than encourage surveillance or permanent judgement.",
  },
  {
    number: "06",
    title: "No permanent safety hierarchy",
    text: "Safety responsibilities should not create a fixed authority structure that gives one group continuous control over another.",
  },
];
