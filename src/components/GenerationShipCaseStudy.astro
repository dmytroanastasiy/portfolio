<CaseProgressNav />

  <!-- ==========================================
       01 — THE TENSION
  =========================================== -->

  <section
    class="case-section"
    id="generation-section-1"
    data-progress-section
    data-progress-label="The tension"
  >
    <div class="section-number">01</div>

    <div class="section-heading">
      <span class="eyebrow">The tension</span>

      <h2>
        A safe society can easily become
        a monitored society.
      </h2>
    </div>

    <div class="section-body">
      <p class="large-copy">
        A generational spaceship would need to support human life
        for decades or even centuries in a closed environment. Safety matters enormously -
        but constant surveillance could create a society built on
        control rather than trust.
      </p>

      <p>
        Our project focused on the security-control theme and asked
        how a closed community could respond to risk, conflict and
        uncertainty while preserving privacy, autonomy and social
        trust.
      </p>
    </div>

    <blockquote class="hmw">
      <span>How might we</span>

      maintain <strong>social safety</strong> for a long period of time in a
      <strong>closed environment</strong> without creating a feeling of
      <strong>excessive monitoring or control</strong>?
    </blockquote>
  </section>


