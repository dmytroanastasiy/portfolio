---
import CaseProgressNav from "./CaseProgressNav.astro";

const {
  title = "Miles & Meals",
  year = "2026",
  type = "Mobile app design · Branding",
  role = "Concept, brand identity, UX/UI design",
} = Astro.props;

const processSteps = [
  "Overview",
  "Brief & audience",
  "Research & moodboard",
  "Identity exploration",
  "Brand system",
  "Wireframes",
  "App Store presence",
  "Onboarding",
  "Personalisation",
  "Core product",
  "Explore",
  "Recipe guidance",
  "Outcome",
];

const quickHighlights = [
  {
    number: "01",
    title: "A meal box with a point of view",
    text: "Miles & Meals reframes subscription food delivery as a mix of convenience, cultural discovery and storytelling.",
  },
  {
    number: "02",
    title: "Brand first, then interface",
    text: "The visual language combines playful illustration, bold typography, off-white surfaces and bright green-yellow accents to feel warm and memorable.",
  },
  {
    number: "03",
    title: "Three core journeys",
    text: "The product revolves around managing your box, exploring cities and dishes, and cooking with guided step-by-step recipes.",
  },
  {
    number: "04",
    title: "A consistent ecosystem",
    text: "From App Store storytelling to onboarding, dashboard, recipe screens and favourites, the brand carries through every touchpoint.",
  },
];

const brandPillars = [
  {
    title: "Out & Social",
    text: "Vibrant, energetic and human. The identity evokes sharing food with friends, busy market stalls and warm evenings outside.",
  },
  {
    title: "Authentic & Open",
    text: "Real flavours and real stories. Raw, in-the-moment photography and hand-written notes replace the polished look of typical meal kits.",
  },
  {
    title: "Trendy, not mainstream",
    text: "Stylish and modern, with smart references to tradition — like coin-shaped box markers that nod to foreign currency and travel.",
  },
];

const visualSystem = [
  "Warm Cream #F3ECE2 — natural ingredients, dough and unbleached market packaging",
  "Green-Black #032000 — an earthy, softer alternative to pure black for text and UI",
  "Sun Yellow #FFC738 — spices, street stalls and warm evenings",
  "Vibrant Mint #18EB9C — fresh herbs and the “Out & Social” energy",
  "Pilcrow Rounded for headings, Helvetica for body, a hand-written marker style for notes",
  "Martin, the brand character, plus patterns built from the logo’s wavy curves",
];

const brandColors = [
  {
    name: "Warm Cream",
    x: 6,
    y: 11,
    line: [28.5, 43],
    hex: "#F3ECE2",
    side: "left",
    text: "References natural ingredients, dough and unbleached market packaging — tying into the brand’s honesty and focus on authenticity.",
  },
  {
    name: "Vibrant Mint",
    x: 3,
    y: 54.5,
    line: [25.5, 44],
    hex: "#18EB9C",
    side: "left",
    text: "Refers to herbs and vegetables and brings the “Out & Social” energy. Trendy, fresh and energetic — a modern pop.",
  },
  {
    name: "Green-Black",
    x: 0,
    y: 77.5,
    line: [22.5, 29],
    hex: "#032000",
    side: "left",
    text: "A very dark, earthy tone instead of pure black. Makes text easier and more pleasant to read next to the rest of the palette.",
  },
  {
    name: "Sun Yellow",
    x: 79,
    y: 32.9,
    line: [58.5, 77.5],
    hex: "#FFC738",
    side: "right",
    text: "Warmth, appetite and culinary discovery — spices, street-food stalls and warm evenings spent eating outside.",
  },
  {
    name: "Clean White",
    x: 80.5,
    y: 69.6,
    line: [70.5, 79],
    hex: "#FFFFFF",
    side: "right",
    text: "The modern canvas. Keeps the visual identity open, clean and highly scalable for all kinds of visuals.",
  },
];

const logoVariants = [
  {
    name: "Brand character mark",
    text: "Martin holding a bowl with the logo as noodles. Used where the brand needs personality, like the loading screen.",
  },
  {
    name: "Secondary logo",
    text: "A compact “m & m” lockup. Road markings nod to the streets and double as drop shadows.",
  },
  {
    name: "Primary logo",
    text: "The main wordmark. Wavy letters read as roads and noodles; the smile is a face and a plate.",
  },
  {
    name: "Stamp",
    text: "The most reduced mark, for small formats, stickers and stamping on packaging.",
  },
];

const fontPairing = [
  {
    name: "Pilcrow Rounded",
    image: "mm-font-pilcrow",
    role: "Headings",
    text: "Welcoming and modern. Its soft, rounded forms mirror the friendly curves of the logo. Used mainly for headings and naming on packaging, with bold as the main weight.",
  },
  {
    name: "Helvetica",
    image: "mm-font-helvetica",
    role: "Body copy",
    text: "The ultimate workhorse. Balanced, clean and timeless, it grounds the design. Used for body copy and subheadings, so everything reads clearly across all brand materials.",
  },
  {
    name: "Hand-written",
    image: "mm-font-handwritten",
    role: "Notes",
    text: "Adds simplicity and raw authenticity, nodding to the quick marker signs at real street-food stalls. Used strictly for tiny notes, scribbles and small annotations.",
  },
];

const Y = "#FFC738";
const D = "#032000";
const M = "#18EB9C";
const W = "#F5F5F5";

const logoColourRows = [
  {
    name: "Primary logo",
    kind: "primary",
    tiles: [[Y, D], [D, Y], [M, D]],
    text: "the full wordmark with the smile, for main brand moments.",
  },
  {
    name: "Secondary logo",
    kind: "secondary",
    tiles: [[Y, D], [D, Y], [M, D]],
    text: "the compact “m & m” lockup for narrow, horizontal spaces.",
  },
  {
    name: "Stamp",
    kind: "stamp",
    tiles: [[Y, D], [D, Y], [M, D], [D, M], [W, D]],
    text: "the most reduced mark, for small formats and for stamping packaging.",
  },
];

const coinNotes = [
  {
    name: "Local Legend",
    text: "White and beige — premium and timeless, for the generational classics.",
  },
  {
    name: "Street Made",
    text: "Bright yellow and orange — the glow of warm evenings sharing street food.",
  },
  {
    name: "Neighbourhood Bakes",
    text: "Orange and beige — warm and simple, like picking up comfort treats.",
  },
];

const productFacts = [
  { label: "Box types", value: "Local Legend, Street Made and Neighbourhood Bakes — 4 recipes each" },
  { label: "Servings", value: "2, 4 or 6 servings — €30, €60 or €75 per box" },
  { label: "Rhythm", value: "Weekly or every two weeks, Tuesday evening or Thursday morning" },
  { label: "Diet", value: "Every box in a vegetarian and a meat-based version" },
  { label: "Sustainability", value: "Compostable packaging and bicycle-based delivery" },
  { label: "Flexibility", value: "Pause or cancel any time through the app" },
];

const boxTypes = [
  {
    title: "Local Legend",
    text: "The dishes people grow up with and never stop craving — timeless local classics you order without looking at the menu.",
  },
  {
    title: "Street Made",
    text: "Fast, bold street food with layered sauces, heat, smoke and crunch — big flavour for people with limited time in the kitchen.",
  },
  {
    title: "Neighbourhood Bakes",
    text: "Snacks, breads, fritters and sweet treats sold on corners and markets, for bakers and dessert lovers.",
  },
];

const outcomePoints = [
  "A clear product proposition that differentiates the service from generic meal-kit apps.",
  "A coherent brand system translated into marketing screens, onboarding and final UI.",
  "A product structure that balances subscription logistics, exploration and cooking support.",
  "A flexible visual language that could extend into packaging, social media and future features.",
];

const imgBase = `${import.meta.env.BASE_URL}miles-and-meals/`;
const figmaUrl = "https://www.figma.com/design/3kBKjNhOqcOx9Iji8INXZK/Miles---Meals?node-id=6817-1887&t=Ikccj6MlT4vrWCq5-1";
---

<article class="miles-case">
  <a
    class="back-button"
    href={import.meta.env.BASE_URL}
    aria-label="Back to main portfolio page"
  >
    ← Back
  </a>

  <header class="case-hero">
    <div class="case-hero__meta">
      <span>{type}</span>
      <span>{year}</span>
    </div>

    <h1>{title}</h1>

    <p class="case-hero__lead">
      A food-box mobile app that turns weekly delivery into an experience built around flavour, discovery and cultural storytelling.
    </p>

    <p class="case-hero__intro">
      Miles &amp; Meals is a branding and app design project for a subscription-based
      food service. The concept combines the practical side of weekly meal delivery
      with the emotional side of travel, local dishes and culinary exploration.
      The result is a product ecosystem where brand, interface and content work together.
    </p>

    <div class="case-hero__details">
      <div>
        <span class="eyebrow">Project</span>
        <p>Brand identity + UX/UI for a mobile food-delivery concept</p>
      </div>

      <div>
        <span class="eyebrow">Role</span>
        <p>{role}</p>
      </div>
    </div>

    <div class="hero-stack">
      <div class="hero-stack__phone">
        <img src={`${imgBase}onboarding-feature1-final.avif`} alt="Miles & Meals — Onboarding screen: discover the world in your kitchen" loading="eager" />
      </div>
      <div class="hero-stack__phone">
        <img src={`${imgBase}welcome1-final.avif`} alt="Miles & Meals — Box setup screen: choose your favourite box" loading="eager" />
      </div>
      <div class="hero-stack__phone">
        <img src={`${imgBase}dashboard-final.avif`} alt="Miles & Meals — Dashboard screen" loading="eager" />
      </div>
      <div class="hero-stack__phone">
        <img src={`${imgBase}explore-final.avif`} alt="Miles & Meals — Explore screen" loading="eager" />
      </div>
      <div class="hero-stack__phone">
        <img src={`${imgBase}recipe-detail-step5-final.avif`} alt="Miles & Meals — Guided recipe step" loading="eager" />
      </div>
    </div>
  </header>

  <nav class="reading-mode" aria-label="Case study reading mode">
    <button type="button" class="reading-mode__button is-active" data-mode="quick">
      Quick read
    </button>

    <button type="button" class="reading-mode__button" data-mode="full">
      Full process
    </button>
  </nav>

  <!-- QUICK READ -->
  <nav class="process-index" aria-label="Quick read sections" data-view="quick">
    <a href="#miles-quick-1"><span>01</span>Overview</a>
    <a href="#miles-quick-2"><span>02</span>Brand snapshot</a>
    <a href="#miles-quick-3"><span>03</span>Product highlights</a>
    <a href="#miles-quick-4"><span>04</span>Outcome</a>
  </nav>

  <section class="case-section quick-read" id="miles-quick-1" data-view="quick">
    <div class="section-number">01</div>

    <div class="section-heading">
      <span class="eyebrow">Overview</span>
      <h2>From meal delivery to a richer food experience.</h2>
    </div>

    <div class="section-body">
      <p class="large-copy">
        The project started with a simple question: how can a meal-box service feel less generic,
        and more like something people genuinely want to explore? Instead of focusing only on delivery,
        Miles &amp; Meals builds a world around food — recipes, cities, local stories and a playful identity.
      </p>
    </div>

    <div class="quick-grid">
      {
        quickHighlights.map((item) => (
          <article class="quick-card">
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="case-section quick-read" id="miles-quick-2" data-view="quick">
    <div class="section-number">02</div>

    <div class="section-heading">
      <span class="eyebrow">Brand snapshot</span>
      <h2>A playful brand built around flavour, travel and warmth.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p>
        The brandboard defines Miles &amp; Meals as friendly, recognisable and easy to remember.
        The visual system uses a soft neutral base, dark green for structure, warm yellow for energy,
        mint highlights for freshness and a mascot that acts as a memorable thread through the whole product.
      </p>

      <p>
        Rather than treating the brand as decoration added after the interface, the project integrates
        brand thinking directly into the product. The result is a system that feels consistent across App Store previews,
        onboarding, navigation, recipe guidance and discovery features.
      </p>
    </div>

    <div class="pillars-grid">
      {
        brandPillars.map((pillar) => (
          <article class="pillar-card">
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))
      }
    </div>

    <div class="brand-block identity-block quick-brand">
      <div class="logo-color-list">
        {
          logoColourRows.map((row) => (
            <figure class="logo-color">
              <div class={`logo-tiles logo-tiles--${row.kind}`} role="img" aria-label={`${row.name} in the brand colours`}>
                {
                  row.tiles.map(([bg, fg]) => (
                    <span class="logo-tile" style={`background:${bg};color:${fg}`}>
                      <span
                        class="logo-tile__mark"
                        style={`-webkit-mask-image:url(${imgBase}mm-mask-${row.kind}.webp);mask-image:url(${imgBase}mm-mask-${row.kind}.webp)`}
                      ></span>
                    </span>
                  ))
                }
              </div>
              <figcaption><strong>{row.name}</strong> — {row.text}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="brand-block brand-block--split identity-block">
      <img class="mascot-image" src={`${imgBase}mm-brand-martin.avif`} alt="Martin, the Miles & Meals brand mascot" loading="lazy" />

      <div class="brand-block__intro">
        <span class="eyebrow">Brand mascot</span>
        <h3>Meet Martin.</h3>
        <p>
          The explorer with a backpack and a huge bowl of noodles — a friendly face that mirrors the audience
          and sets the illustration style for the whole brand.
        </p>
      </div>
    </div>

    <div class="brand-block identity-block">
      <div class="brand-block__intro">
        <span class="eyebrow">Brand in action</span>
        <h3>Built for the real world.</h3>
        <p>
          From stickers to take-away bags, the identity is designed to live on physical touchpoints.
          Every piece should feel authentic, as if it came straight from a street-food stall.
        </p>
      </div>

      <div class="action-row action-row--stickers">
        <img src={`${imgBase}mm-action-sticker-1.avif`} alt="Miles & Meals sticker mockup" loading="lazy" />
        <img src={`${imgBase}mm-action-sticker-2.avif`} alt="Miles & Meals sticker with Martin" loading="lazy" />
      </div>

      <div class="action-row">
        <img src={`${imgBase}mm-action-bag-1.avif`} alt="Neighbourhood Bakes paper bags" loading="lazy" />
        <img src={`${imgBase}mm-action-bag-2.avif`} alt="Local Legend paper bag mockup" loading="lazy" />
        <img src={`${imgBase}mm-action-bag-3.avif`} alt="Street Made paper bag mockup" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="case-section quick-read" id="miles-quick-3" data-view="quick">
    <div class="section-number">03</div>

    <div class="section-heading">
      <span class="eyebrow">Product highlights</span>
      <h2>Marketing, onboarding, discovery and cooking in one ecosystem.</h2>
    </div>

    <div class="screen-row screen-row--four">
      <figure class="phone-card">
        <div class="phone-screen"><img src={`${imgBase}appstore3-final.avif`} alt="App Store detail preview for Miles & Meals" /></div>
        <figcaption>App Store storytelling</figcaption>
      </figure>

      <figure class="phone-card">
        <div class="phone-screen"><img src={`${imgBase}welcome1-final.avif`} alt="Box customisation screen" /></div>
        <figcaption>Onboarding setup</figcaption>
      </figure>

      <figure class="phone-card">
        <div class="phone-screen phone-screen--nav" style="--nav-ratio: 0.2814"><img src={`${imgBase}mm-mybox-screen.avif`} alt="My Box dashboard screen" /><img class="phone-nav" src={`${imgBase}mm-mybox-nav.avif`} alt="" aria-hidden="true" /></div>
        <figcaption>Weekly box management</figcaption>
      </figure>

      <figure class="phone-card">
        <div class="phone-screen phone-screen--nav" style="--nav-ratio: 0.4535"><img src={`${imgBase}mm-recipe-detail-welcome-screen.avif`} alt="Recipe detail screen" /><img class="phone-nav" src={`${imgBase}mm-recipe-detail-welcome-nav.avif`} alt="" aria-hidden="true" /></div>
        <figcaption>Guided cooking</figcaption>
      </figure>
    </div>
  </section>

  <section class="case-section quick-read" id="miles-quick-4" data-view="quick">
    <div class="section-number">04</div>

    <div class="section-heading">
      <span class="eyebrow">Outcome</span>
      <h2>A coherent app concept with a clear emotional angle.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p>
        What makes Miles &amp; Meals stand out is not a single screen, but the way the whole system hangs together.
        The onboarding explains the offer, the home flow supports logistics, the explore flow adds editorial depth,
        and the recipe experience turns ingredients into a practical, engaging journey.
      </p>

      <p>
        The project demonstrates how strong branding can directly improve product design: it gives the app a clearer voice,
        a more memorable identity and a stronger reason for users to connect with the service beyond pure convenience.
      </p>
    </div>

    <ul class="outcome-list">
      {
        outcomePoints.map((item) => (
          <li>{item}</li>
        ))
      }
    </ul>
  </section>

  <!-- FULL PROCESS -->
  <nav class="process-index full-process" aria-label="Case study sections" data-view="full">
    {
      processSteps.map((step, index) => (
        <a href={`#miles-section-${index + 1}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          {step}
        </a>
      ))
    }
  </nav>

  <div class="full-process" data-view="full">
    <CaseProgressNav />
  </div>

  <section
    class="case-section full-process"
    id="miles-section-1"
    data-view="full"
    data-progress-section
    data-progress-label="Overview"
  >
    <div class="section-number">01</div>

    <div class="section-heading">
      <span class="eyebrow">Overview</span>
      <h2>A food-box service that feels more like discovery than routine.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p class="large-copy">
        Many meal-delivery products are useful, but they often feel interchangeable.
        Miles &amp; Meals explores an alternative direction: a subscription service where convenience is still important,
        but it does pay attention to storytelling and identity.
      </p>

      <p>
        The concept imagines an app that helps people receive their weekly box, manage deliveries,
        choose preferences, discover local dishes from around the world and follow rich recipe flows.
        The project brings branding and digital product design together so the interface supports a bigger narrative.
      </p>
    </div>
  </section>

  <section
    class="case-section full-process"
    id="miles-section-2"
    data-view="full"
    data-progress-section
    data-progress-label="Brief & audience"
  >
    <div class="section-number">02</div>

    <div class="section-heading">
      <span class="eyebrow">Brief &amp; audience</span>
      <h2>Street food. Local stories. At home.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p>
        The client is a duo, Rob Reinaerdt and Melanie Torres, who met over a shared love for street food.
        Their concept: curated, small-batch boxes built around one signature dish per city, developed together with locals
        and translated into an at-home cooking experience. Antwerp is the pilot city, with Flanders and the Netherlands as the long-term goal.
      </p>

      <p>
        The target audience is <strong>“The Discoverer”</strong>: urban professionals aged 25–50 who are tired of repetitive weeknight meals
        and mainstream food trends. They look for authenticity, transparency and new experiences, have some cooking experience,
        and want exclusivity without a steep learning curve.
      </p>
    </div>

    <div class="fact-grid">
      {
        productFacts.map((fact) => (
          <article class="fact-card">
            <span class="eyebrow">{fact.label}</span>
            <p>{fact.value}</p>
          </article>
        ))
      }
    </div>

    <div class="pillars-grid">
      {
        boxTypes.map((box) => (
          <article class="pillar-card">
            <h3>{box.title}</h3>
            <p>{box.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="case-section full-process"
    id="miles-section-3"
    data-view="full"
    data-progress-section
    data-progress-label="Research & moodboard"
  >
    <div class="section-number">03</div>

    <div class="section-heading">
      <span class="eyebrow">Research &amp; moodboard</span>
      <h2>Stepping away from the usual meal-kit look.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p>
        Before designing, I looked at how existing Belgian and Dutch meal-box brands present themselves — HelloFresh, eFarmz and Foodbag.
        They are clean and trustworthy, but visually, I felt they were too similar.
      </p>

      <p>
        Miles &amp; Meals needed the opposite energy. The moodboard dives into raw street culture that can be said in five design keywords:
        social, energetic, authentic, friendly and open.
      </p>
    </div>

    <div class="board-grid board-grid--three">
      <figure class="board-card">
        <img src={`${imgBase}mm-process-competitor-hellofresh.avif`} alt="Competitor analysis of HelloFresh" loading="lazy" />
        <figcaption>Competitor scan — HelloFresh</figcaption>
      </figure>
      <figure class="board-card">
        <img src={`${imgBase}mm-process-competitor-efarmz.avif`} alt="Competitor analysis of eFarmz" loading="lazy" />
        <figcaption>Competitor scan — eFarmz</figcaption>
      </figure>
      <figure class="board-card">
        <img src={`${imgBase}mm-process-competitor-foodbag.avif`} alt="Competitor analysis of Foodbag" loading="lazy" />
        <figcaption>Competitor scan — Foodbag</figcaption>
      </figure>
    </div>

    <figure class="board-card board-card--wide">
      <img src={`${imgBase}mm-process-moodboard.avif`} alt="Moodboard with street food stalls, colourful stools and market scenes" loading="lazy" />
      <figcaption>Moodboard</figcaption>
    </figure>

    <p class="small-note">
      The moodboard collects raw street-food culture: stacked plastic stools, market stalls and food trucks, hand-painted signs,
      take-away bags and food eaten on the go. The mood to translate into design:
      <strong>social, energetic, authentic, community-driven, friendly and open.</strong>
    </p>

    <figure class="board-card board-card--wide">
      <img src={`${imgBase}mm-brand-styleboard.avif`} alt="Styleboard with character illustrations, packaging textures, hand-written scribbles and international graphic references" loading="lazy" />
      <figcaption>Styleboard</figcaption>
    </figure>

    <p class="small-note">
      The styleboard sets the visual ingredients: <strong>playful, simple character illustrations</strong> for a kind mood
      (later becoming the brand character), <strong>packaging textures</strong> like foil, cardboard and plastic as a nod to real street food,
      <strong>hand-written scribbles</strong> like the notes cooks write on take-away packaging, and a <strong>global, international aesthetic</strong>
      with glyphs and characters from different cultures. Together they blend playful energy with raw authenticity.
    </p>
  </section>

  <section
    class="case-section full-process"
    id="miles-section-4"
    data-view="full"
    data-progress-section
    data-progress-label="Identity exploration"
  >
    <div class="section-number">04</div>

    <div class="section-heading">
      <span class="eyebrow">Identity exploration</span>
      <h2>From logo sketches to a system with a smile.</h2>
    </div>

    <div class="section-body two-col-copy">
      <p>
        The logo went through several rounds of try-outs exploring may different ways to creaivey approach the idea. The process involved experimenting with various shapes, forms, and styles.
      </p>

      <p>
        Colour and type were explored in parallel. The final palette pairs a warm cream and a very dark green-black with
        sun yellow and a vibrant mint, while Pilcrow Rounded, Helvetica and a hand-written marker style balance friendliness,
        clarity and street-sign authenticity.
      </p>
    </div>

    <figure class="board-card board-card--wide identity-block">
      <div
        class="project-media project-media--interactive"
        data-drag-scroll
        aria-label="Logo try-outs. Drag to explore the image and zoom in for detail."
      >
        <span
