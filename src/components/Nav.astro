---
// Nav.astro — floating pill navigation (home page).
const base = import.meta.env.BASE_URL;

// Drop your CV into /public with this exact name and the button will work.
const resumeFile = "Dmytro_Anastasiy-CV.pdf";
---

<nav class="site-nav" aria-label="Main">
  <a class="site-nav__logo" href={base}>Dmytro Anastasiy<span>.</span></a>

  <div class="site-nav__links">
    <a class="site-nav__link" href="#works">Work</a>
    <a class="site-nav__link" href="#about">About</a>
    <a class="site-nav__link" href="#contact">Contact</a>
    <a class="site-nav__cta" href={`${base}${resumeFile}`} download="Dmytro Anastasiy — CV.pdf">Résumé ↓</a>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 20px;
    left: 50%;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: calc(100% - 48px);
    max-width: 820px;
    padding: 10px 12px 10px 20px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07), 0 1px 4px rgba(0, 0, 0, 0.04);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    transform: translate(-50%, 0);
    animation: nav-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translate(-50%, -24px);
    }
  }

  .site-nav__logo {
    color: #161616;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 0.25s;
  }

  .site-nav__logo span {
    color: #9a9a9a;
  }

  .site-nav__logo:hover {
    opacity: 0.45;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .site-nav__link {
    padding: 7px 14px;
    border-radius: 999px;
    color: #686868;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.22s, color 0.22s;
  }

  .site-nav__link:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #161616;
  }

  .site-nav__cta {
    margin-left: 6px;
    padding: 8px 18px;
    border-radius: 999px;
    background: #161616;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: opacity 0.22s, transform 0.22s;
  }

  .site-nav__cta:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  .site-nav__cta:active {
    transform: scale(0.95);
  }

  @media (max-width: 600px) {
    .site-nav {
      top: 14px;
      width: calc(100% - 32px);
      padding: 10px 12px 10px 18px;
    }

    .site-nav__link {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      animation: none;
    }
  }
</style>
