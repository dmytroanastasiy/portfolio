  display: block;

  width: 100%;
  max-width: 100%;
    justify-self: flex-end;
  height: clamp(18rem, 55vw, 38rem);
  object-position: 50% 20%;
  object-fit: cover;

  background: #111;
}

@media (min-width: 900px) {
  .case-video {
    height: clamp(18rem, 28vw, 28rem);
  }
}
  .case-study {
    --page-bg: #f4f2ee;
