<script>
  /* ==========================================
     QUICK / FULL CASE STUDY
  ========================================== */

  const modeButtons =
    document.querySelectorAll(".reading-mode__button");

  const fullSections =
    document.querySelectorAll(".full-process");


  function setReadingMode(mode) {
    modeButtons.forEach((button) => {
      button.classList.toggle(
        "is-active",
        button.dataset.mode === mode
      );
    });


    fullSections.forEach((section) => {
      section.classList.toggle(
        "is-hidden",
        mode === "quick"
      );
    });
  }


  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setReadingMode(button.dataset.mode);
    });
  });


  setReadingMode("quick");


  /* ==========================================
     METHOD TABS
  ========================================== */

  const tabs =
    document.querySelectorAll(".method-tab");

  const panels =
    document.querySelectorAll(".method-panel");


  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const method =
        tab.dataset.method;


      tabs.forEach((item) =>
        item.classList.remove("is-active")
      );


      panels.forEach((panel) =>
        panel.classList.remove("is-active")
      );


      tab.classList.add("is-active");


      document
        .querySelector(
          `[data-method-panel="${method}"]`
        )
        ?.classList.add("is-active");
    });
  });


  /* ==========================================
     DRAGGABLE + ZOOMABLE RESEARCH ARTEFACTS
  ========================================== */

  const draggableMedia =
    document.querySelectorAll<HTMLElement>("[data-drag-scroll]");


  draggableMedia.forEach((viewport) => {
    const image =
      viewport.querySelector<HTMLImageElement>(".media-pan__image");

    if (!image) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let startScrollLeft = 0;
    let startScrollTop = 0;

    let zoom = 1;
    let baseWidth = 0;
    let baseHeight = 0;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 3;


    const captureBaseSize = () => {
      if (!baseWidth || !baseHeight) {
        /*
          offsetWidth / offsetHeight use the image's layout size and do
          not overwrite any transform / positioning you set in the
          individual .img-* classes below.
        */
        baseWidth = image.offsetWidth;
        baseHeight = image.offsetHeight;
      }
    };


    const centerViewportOnMobile = () => {
      if (!window.matchMedia("(max-width: 800px)").matches) return;

      requestAnimationFrame(() => {
        viewport.scrollLeft = Math.max(
          0,
          (viewport.scrollWidth - viewport.clientWidth) / 2
        );

        viewport.scrollTop = Math.max(
          0,
          (viewport.scrollHeight - viewport.clientHeight) / 2
        );
      });
    };


    if (image.complete) {
      captureBaseSize();
      centerViewportOnMobile();
    } else {
      image.addEventListener(
        "load",
        () => {
          captureBaseSize();
          centerViewportOnMobile();
        },
        { once: true }
      );
    }


    window.addEventListener("resize", centerViewportOnMobile);


    const applyZoom = (
      nextZoom: number,
      clientX?: number,
      clientY?: number
    ) => {
      captureBaseSize();

      if (!baseWidth || !baseHeight) return;

      const previousZoom = zoom;

      zoom = Math.min(
        MAX_ZOOM,
        Math.max(MIN_ZOOM, nextZoom)
      );

      if (zoom === previousZoom) return;

      const rect = viewport.getBoundingClientRect();

      const anchorX =
        clientX ?? rect.left + rect.width / 2;

      const anchorY =
        clientY ?? rect.top + rect.height / 2;

      const localX = anchorX - rect.left;
      const localY = anchorY - rect.top;

      const contentX = viewport.scrollLeft + localX;
      const contentY = viewport.scrollTop + localY;


      if (zoom === 1) {
        /*
          Removing these inline values restores your exact manually
          configured image sizing from the CSS at the bottom of the file.
        */
        image.style.removeProperty("width");
        image.style.removeProperty("height");
        viewport.classList.remove("is-zoomed");
      } else {
        image.style.width = `${baseWidth * zoom}px`;
        image.style.height = `${baseHeight * zoom}px`;
        viewport.classList.add("is-zoomed");
      }


      const ratio = zoom / previousZoom;

      requestAnimationFrame(() => {
        viewport.scrollLeft =
          contentX * ratio - localX;

        if (zoom > 1) {
          viewport.scrollTop =
            contentY * ratio - localY;
        } else {
          viewport.scrollTop = 0;
        }
      });
    };


    /* ------------------------------------------
       DRAG / PAN
    ------------------------------------------ */

    viewport.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;

      isDragging = true;

      startX = event.clientX;
      startY = event.clientY;

      startScrollLeft = viewport.scrollLeft;
      startScrollTop = viewport.scrollTop;

      viewport.classList.add("is-dragging");
      viewport.setPointerCapture?.(event.pointerId);
    });


    viewport.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      const distanceX = event.clientX - startX;
      const distanceY = event.clientY - startY;

      viewport.scrollLeft = startScrollLeft - distanceX;

      if (zoom > 1) {
        viewport.scrollTop = startScrollTop - distanceY;
      }
    });


    const stopDragging = (event) => {
      if (!isDragging) return;

      isDragging = false;
      viewport.classList.remove("is-dragging");

      if (viewport.hasPointerCapture?.(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }
    };


    viewport.addEventListener("pointerup", stopDragging);
    viewport.addEventListener("pointercancel", stopDragging);

    viewport.addEventListener("lostpointercapture", () => {
      isDragging = false;
      viewport.classList.remove("is-dragging");
    });


    /* ------------------------------------------
       ZOOM

       Mac trackpad pinch works automatically in Chrome.
       You can also hold Command / Control / Option while
       scrolling over an image.
    ------------------------------------------ */

    viewport.addEventListener(
      "wheel",
      (event) => {
        const wantsZoom =
          event.ctrlKey ||
          event.metaKey ||
          event.altKey;

        if (!wantsZoom) return;

        event.preventDefault();

        /* Smooth zoom works better with Mac trackpad pinch gestures. */
        const factor = Math.exp(-event.deltaY * 0.01);

        applyZoom(
          zoom * factor,
          event.clientX,
          event.clientY
        );
      },
      { passive: false }
    );


    /* Double-click: zoom in / reset. */
    viewport.addEventListener("dblclick", (event) => {
      event.preventDefault();

      applyZoom(
        zoom > 1 ? 1 : 1.5,
        event.clientX,
        event.clientY
      );
    });


    /* Keyboard support when the image viewport is focused. */
    if (!viewport.hasAttribute("tabindex")) {
      viewport.tabIndex = 0;
    }


    viewport.addEventListener("keydown", (event) => {
      if (event.key === "+" || event.key === "=") {
        event.preventDefault();
        applyZoom(zoom * 1.2);
      }

      if (event.key === "-") {
        event.preventDefault();
        applyZoom(zoom / 1.2);
      }

      if (event.key === "0") {
        event.preventDefault();
        applyZoom(1);
      }
    });
  });
</script>


<script>
  /* Process index adapts to Quick read / Full process:
     hides links to sections that are hidden and renumbers the rest
     (index card + section number stay in sync). */
  const indexLinks = [...document.querySelectorAll(".process-index a")];

  indexLinks.forEach((link) => {
    const target = document.querySelector(link.getAttribute("href"));
    const num = link.querySelector("span");
    const secNum = target?.querySelector(":scope > .section-number");
    link._target = target;
    link._num = num;
    link._secNum = secNum;
    link._orig = num?.textContent;
    if (secNum) secNum.dataset.orig = secNum.textContent;
  });

  function syncProcessIndex() {
    let n = 0;
    indexLinks.forEach((link) => {
      const hidden = !link._target || link._target.classList.contains("is-hidden");
      link.hidden = hidden;
      if (hidden) return;
      n += 1;
      const label = String(n).padStart(2, "0");
      if (link._num) link._num.textContent = label;
      if (link._secNum) link._secNum.textContent = label;
    });
  }

  // Re-sync whenever a section is shown/hidden by the reading-mode toggle
  const indexObserver = new MutationObserver(syncProcessIndex);
  indexLinks.forEach((link) => {
    if (link._target) indexObserver.observe(link._target, { attributes: true, attributeFilter: ["class"] });
  });

  syncProcessIndex();
</script>

