---

const {
  title = "From Scrolling to Watching",
  year = "2026",
  type = "UX Research",
  role = "Research · Synthesis · Visual Communication",
  figjamUrl = "#",
} = Astro.props;


const methods = [
  {
    number: "01",
    label: "Survey",
    title: "Breadth",
    text:
      "The survey gave us a broader view of recurring behaviours, preferences and friction around content discovery.",

    insights: [
      {
        number: "01",
        title: "Discovery often starts elsewhere",
        text:
          "Short-form and social platforms play an important role in discovering what to watch. The journey often begins before users even open a streaming platform.",
      },

      {
        number: "02",
        title: "People want help narrowing the choice",
        text:
          "Participants value recommendations when they reduce effort and feel relevant to their interests, rather than simply presenting more content.",
      },

      {
        number: "03",
        title: "More choice can create more friction",
        text:
          "Large catalogues do not automatically make choosing easier. Too many options can extend the browsing process and make commitment more difficult.",
      },
    ],
  },

  {
    number: "02",
    label: "Interviews",
    title: "Depth",
    text:
      "Interviews helped us move from what people do toward understanding why they do it.",

    insights: [
      {
        number: "01",
        title: "The right choice depends on the moment",
        text:
          "What people want to watch changes with mood, energy and situation. A technically relevant recommendation is not always contextually relevant.",
      },

      {
        number: "02",
        title: "Value influences the decision",
        text:
          "Availability, subscriptions and the perceived value of a piece of content affect whether people continue searching, switch services or abandon a choice.",
      },

      {
        number: "03",
        title: "Recommendations are a shortcut",
        text:
          "People rely on platform recommendations and familiar discovery patterns to reduce the work of searching, especially when they do not already know what they want.",
      },
    ],
  },

  {
    number: "03",
    label: "Cultural Probe",
    title: "Context",
    text:
      "The cultural probe brought the research closer to the real moment of choice and revealed behaviours that are difficult to reconstruct afterward.",

    insights: [
      {
        number: "01",
        title: "Choosing is often social",
        text:
          "Friends, family and shared viewing situations influence what gets considered and what eventually gets selected.",
      },

      {
        number: "02",
        title: "Searching has an emotional cost",
        text:
          "Long browsing sessions can shift from curiosity into frustration, especially when nothing immediately feels right.",
      },

      {
        number: "03",
        title: "Context changes priorities",
        text:
          "Time, mood, company and the situation around the viewer can matter as much as genre or previous viewing history.",
      },

      {
        number: "04",
        title: "People change strategy when stuck",
        text:
          "When browsing stops working, people move between recommendations, search, external platforms or familiar content instead of following one fixed discovery path.",
      },

      {
        number: "05",
        title: "Decision fatigue builds over time",
        text:
          "The longer users remain undecided, the more effort the process requires — sometimes making a familiar or easy option more attractive than continued exploration.",
      },
    ],
  },
];


const processSteps = [
  "Problem",
  "Research Question",
  "Audience",
  "Assumptions",
  "Research",
  "Synthesis",
  "Insight",
];
---


<article class="case-study">

  <!-- ============================================
       HERO
  ============================================= -->

  <header class="case-hero">
    <div class="case-hero__meta">
      <span>{type}</span>
      <span>{year}</span>
    </div>

    <h1>{title}</h1>

    <p class="case-hero__lead">
      What makes someone stop searching and actually press play?
    </p>

    <p class="case-hero__intro">
      A mixed-method UX research project investigating how people
      discover content, make viewing decisions, and experience the
      space between endless browsing and finally choosing something.
    </p>

    <div class="case-hero__details">
      <div>
        <span class="eyebrow">Role</span>
        <p>{role}</p>
      </div>

      <div>
        <span class="eyebrow">Methods</span>
        <p>
          Secondary Research · Survey · Interviews · Cultural Probe
        </p>
      </div>
    </div>

    <!-- Replace with hero video / GIF -->
    <!-- <div class="media-placeholder media-placeholder--hero">
      <span>
         <video
  class="case-video"
  src={`${import.meta.env.BASE_URL}/AdobeStock_577572810.mov`}
  autoplay
  muted
  loop
  playsinline
></video> 
      </span>
    </div> -->
  </header>


  <!-- ============================================
       QUICK / FULL TOGGLE
  ============================================= -->

  <nav class="reading-mode" aria-label="Case study reading mode">
    <button
      class="reading-mode__button is-active"
      data-mode="quick"
      type="button"
    >
      Quick read
    </button>

    <button
      class="reading-mode__button"
      data-mode="full"
      type="button"
    >
      Full process
    </button>
  </nav>


  <!-- ============================================
       PROCESS INDEX
  ============================================= -->

  <div class="process-index">
    {processSteps.map((step, index) => (
      <a href={`#section-${index + 1}`}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        {step}
      </a>
    ))}
  </div>


  <!-- ============================================
       01 — PROBLEM
  ============================================= -->

  <section
    class="case-section case-section--intro"
    id="section-1"
  >
    <div class="section-number">01</div>

    <div class="section-heading">
      <span class="eyebrow">The tension</span>

      <h2>
        Choosing something to watch should be easy.
        It often isn't.
      </h2>
    </div>

    <div class="section-body">
      <p class="large-copy">
        Searching for content can become an activity of its own.
        People move between recommendations, categories, platforms
        and short-form feeds before ever committing to something.
      </p>

      <p>
        Instead of immediately designing another interface, we wanted
        to understand what happens during that decision: what people
        look for, what makes them hesitate, what they trust, and what
        eventually makes them stop scrolling.
      </p>
    </div>

    <!-- <div class="media-placeholder"> -->
      <video
  class="case-video"
  src={`${import.meta.env.BASE_URL}/AdobeStock_577572810.mov`}
  autoplay
  muted
  loop
  playsinline
></video> 
    <!-- </div> -->
  </section>


  <!-- ============================================
       02 — RESEARCH QUESTION
       Full-process section
  ============================================= -->

  <section
    class="case-section full-process"
    id="section-2"
  >
    <div class="section-number">02</div>

    <div class="section-heading">
      <span class="eyebrow">Framing</span>

      <h2>
        Before researching the answer,
        we had to find the right question.
      </h2>
    </div>

    <div class="section-body">
      <p class="large-copy">
        Our initial problem was broad: how might we improve the
        experience of searching for content?
      </p>

      <p>
        We decomposed the problem using an Ishikawa diagram and an
        issue tree, separating recommendation, interface, habits,
        context, trust and decision-making into questions we could
        actually investigate.
      </p>
    </div>


    <!-- Storytelling stack -->
    <div class="artifact-story">
      <article class="artifact">
        <div>
          <span class="eyebrow">01</span>
          <h3>Ishikawa diagram</h3>

          <p>
            Breaking one broad problem into possible causes.
          </p>
        </div>

        <div class="media-placeholder">
          <span>Ishikawa image</span>
        </div>
      </article>


      <article class="artifact">
        <div>
          <span class="eyebrow">02</span>
          <h3>Issue tree</h3>

          <p>
            Turning those causes into researchable branches.
          </p>
        </div>

        <div class="media-placeholder">
          <span>Issue tree image</span>
        </div>
      </article>


      <article class="artifact">
        <div>
          <span class="eyebrow">03</span>
          <h3>Refined question</h3>

          <p>
            Narrowing the scope toward the decision behind content
            discovery.
          </p>
        </div>

        <div class="media-placeholder">
          <span>Research question artefact</span>
        </div>
      </article>
    </div>
  </section>


  <!-- ============================================
       03 — AUDIENCE
  ============================================= -->

  <section
    class="case-section full-process"
    id="section-3"
  >
    <div class="section-number">03</div>

    <div class="section-heading">
      <span class="eyebrow">Audience</span>

      <h2>
        One audience.
        Different relationships with content.
      </h2>
    </div>

    <div class="section-body">
      <p>
        We didn't want to treat viewers as one homogeneous group.
        Different levels of familiarity, confidence and engagement
        influence the way people search for and evaluate content.
      </p>
    </div>


    <div class="audience-grid">
      <article>
        <span class="eyebrow">Archetype 01</span>
        <h3>Noob</h3>

        <p>
          Draft description of the more casual / less structured
          discovery behaviour.
        </p>

        <div class="media-placeholder">
          <span>Noob visual</span>
        </div>
      </article>


      <article>
        <span class="eyebrow">Archetype 02</span>
        <h3>Nerd</h3>

        <p>
          Draft description of the highly engaged / more established
          discovery behaviour.
        </p>

        <div class="media-placeholder">
          <span>Nerd visual</span>
        </div>
      </article>
    </div>
  </section>


  <!-- ============================================
       04 — ASSUMPTIONS / ECOSYSTEM
  ============================================= -->

  <section
    class="case-section full-process"
    id="section-4"
  >
    <div class="section-number">04</div>

    <div class="section-heading">
      <span class="eyebrow">Scoping</span>

      <h2>
        Separating evidence
        from assumptions.
      </h2>
    </div>

    <div class="section-body">
      <p>
        Before collecting new data, we mapped what we already knew,
        what we believed to be true, and what still needed evidence.
      </p>
    </div>


    <div class="artifact-grid">
      <article>
        <h3>Ecosystem map</h3>

        <div class="media-placeholder">
          <span>Ecosystem map</span>
        </div>
      </article>


      <article>
        <h3>Assumption matrix</h3>

        <div class="media-placeholder">
          <span>Assumption matrix</span>
        </div>
      </article>


      <article>
        <h3>Stakeholder matrix</h3>

        <div class="media-placeholder">
          <span>Stakeholder matrix</span>
        </div>
      </article>
    </div>
  </section>


  <!-- ============================================
       RESEARCH PLAN
  ============================================= -->

  <section class="case-section full-process">
    <div class="section-heading">
      <span class="eyebrow">Research plan</span>

      <h2>
        Every assumption needed
        a way to fail.
      </h2>
    </div>

    <div class="section-body">
      <p>
        Broad hypotheses were translated into test cards and then
        into questions that could challenge them through research.
      </p>
    </div>


    <div class="flow">
      <div>
        <span>01</span>
        <strong>Hypothesis</strong>
      </div>

      <span class="flow-arrow">→</span>

      <div>
        <span>02</span>
        <strong>Test card</strong>
      </div>

      <span class="flow-arrow">→</span>

      <div>
        <span>03</span>
        <strong>Research question</strong>
      </div>
    </div>

    <div class="media-placeholder">
      <span>Sticky notes → Test cards → Questions</span>
    </div>
  </section>


  <!-- ============================================
       05 — METHODS
  ============================================= -->

  <section
    class="case-section"
    id="section-5"
  >
    <div class="section-number">05</div>

    <div class="section-heading">
      <span class="eyebrow">Primary research</span>

      <h2>
        Three methods.
        Three different views of the same problem.
      </h2>
    </div>


    <div class="methods">
      <div class="method-tabs" role="tablist">
        {methods.map((method, index) => (
          <button
            type="button"
            class:list={[
              "method-tab",
              index === 0 && "is-active",
            ]}
            data-method={index}
          >
            <span>{method.number}</span>
            {method.label}
          </button>
        ))}
      </div>


      <div class="method-panels">
  {methods.map((method, index) => (
    <article
      class:list={[
        "method-panel",
        index === 0 && "is-active",
      ]}
      data-method-panel={index}
    >
      <div class="method-intro">
        <span class="eyebrow">{method.label}</span>

        <h3>{method.title}</h3>

        <p>{method.text}</p>
      </div>

<div class="insights-carousel-wrap">
      <div
        class="insights-carousel"
        aria-label={`${method.label} insights`}
      >
        {method.insights.map((insight) => (
          <article class="insight-card">
            <div class="insight-card__top">
              <span class="insight-card__label">
                Insight
              </span>

              <span class="insight-card__number">
                {insight.number}
              </span>
            </div>

            <div class="insight-card__content">
              <h4>{insight.title}</h4>

              <p>{insight.text}</p>
            </div>

            <span
              class="insight-card__method"
              aria-hidden="true"
            >
              {method.label}
            </span>
          </article>
        ))}
      </div>
      </div>
    </article>
  ))}
</div>
    </div>
  </section>


  <!-- ============================================
       06 — SYNTHESIS
  ============================================= -->

  <section
    class="case-section"
    id="section-6"
  >
    <div class="section-number">06</div>

    <div class="section-heading">
      <span class="eyebrow">Synthesis</span>

      <h2>
        Turning evidence
        into patterns.
      </h2>
    </div>

    <div class="section-body">
      <p class="large-copy">
        Collecting information wasn't the difficult part.
        Deciding what it meant together was.
      </p>

      <p>
        Survey responses, interviews and cultural-probe material
        were compared through thematic and segmentation work.
        We looked for recurring patterns — and for contradictions.
      </p>
    </div>


    <div class="synthesis-flow">
      <div class="synthesis-source">
        <span>Survey</span>
        <span>Interviews</span>
        <span>Cultural Probe</span>
      </div>

      <div class="synthesis-arrow">
        ↓
      </div>

      <div class="synthesis-middle">
        <span>Thematic analysis</span>
        <span>Segmentation</span>
        <span>Patterns</span>
      </div>

      <div class="synthesis-arrow">
        ↓
      </div>

      <div class="synthesis-result">
        Insight
      </div>
    </div>


  
  </section>


  <!-- ============================================
       07 — MAIN INSIGHT
  ============================================= -->

  <section
  class="main-insight"
  id="section-7"
>
  <span class="eyebrow">Our main insight</span>

  <h2>
    People don't want more choice.
    They want more control.
  </h2>

  <p>
    Across the Cultural Probe, users consistently gravitated toward
    experiences that felt familiar, simple and emotionally aligned.
    Overwhelming choices, trend-driven content and algorithmic
    recommendations often created friction rather than confidence.
    The easier it was to maintain a sense of control and emotional
    safety, the easier it became to decide what to watch.
  </p>
</section>


  <!-- ============================================
       OUTCOME
  ============================================= -->

  <section class="case-section outcome-section">
  <div class="section-heading">
    <span class="eyebrow">Outcome</span>

    <h2>
      The outcome was a direction,
      not an interface.
    </h2>
  </div>

  <div class="section-body outcome-copy">
    <p>
      The project produced a clearer understanding of the content-discovery
      problem rather than a finished interface. Through secondary research,
      surveys, interviews and a cultural probe, we were able to define the
      audience more precisely, challenge our initial assumptions and identify
      recurring patterns across different research methods.
    </p>

    <p>
      The strongest direction that emerged was the importance of control,
      familiarity and emotional alignment during content discovery. Instead
      of simply giving users more recommendations or more choice, future
      concepts should help reduce cognitive effort and make the decision
      process feel calmer, more predictable and more personal.
    </p>

    <p>
      This research therefore became a foundation for future design work:
      a clearer problem space, an evidence-backed design direction and a set
      of principles that could be translated into concepts and prototypes
      in the next phase.
    </p>
  </div>
</section>


  <!-- ============================================
       NEXT STEPS / REFLECTION
  ============================================= -->

  <section class="case-section reflection">
    


    <div class="reflection-copy">
      <span class="eyebrow">Reflection</span>

      <h2>
        Research changed the way I think
        about “the problem”.
      </h2>

      <p>
        This project changed the way I look at problems before trying to solve
  them. I usually enjoy moving quickly into ideas and making, but this time
  I spent much more time observing, questioning assumptions and going deeper
  into the reasons behind people's behaviour. I really enjoyed that process.
  Seeing how survey data, interviews and contextual research could reveal
  different parts of the same problem made me more patient and intentional
  as a designer. I feel that I grew through this project, especially in
  learning that good research does not simply confirm an idea — it can
  completely change the direction you thought you were heading in.
      </p>
    </div>
  </section>


  <!-- ============================================
       FIGJAM
  ============================================= -->

  <section class="figjam">
    <div>
      <span class="eyebrow">Full process</span>

      <h2>
        Want the messy version?
      </h2>

      <p>
        The case study above is the edited story. The complete
        workspace contains diagrams, assumptions, test cards,
        sources, analysis, experiments and iterations.
      </p>

      <a
        href={figjamUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="figjam-link"
      >
        Explore the complete FigJam
        <span aria-hidden="true">↗</span>
      </a>
    </div>

   <div class="figjam-image-wrap">
  <img
    class="figjam-image"
    src={`${import.meta.env.BASE_URL}figjam-screenshot.png`}
    alt="Overview of the FigJam research workspace"
    loading="lazy"
  />
</div>
  </section>

</article>


<script>
  /* ==========================================
     QUICK / FULL CASE STUDY
  ========================================== */

  const modeButtons =
    document.querySelectorAll(".reading-mode__button");

  const fullSections =
    document.querySelectorAll(".full-process");


  function setReadingMode(mode) {
    modeButtons.forEach((button) => {
      button.classList.toggle(
        "is-active",
        button.dataset.mode === mode
      );
    });


    fullSections.forEach((section) => {
      section.classList.toggle(
        "is-hidden",
        mode === "quick"
      );
    });
  }


  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setReadingMode(button.dataset.mode);
    });
  });


  setReadingMode("quick");


  /* ==========================================
     METHOD TABS
  ========================================== */

  const tabs =
    document.querySelectorAll(".method-tab");

  const panels =
    document.querySelectorAll(".method-panel");


  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const method =
        tab.dataset.method;


      tabs.forEach((item) =>
        item.classList.remove("is-active")
      );


      panels.forEach((panel) =>
        panel.classList.remove("is-active")
      );


      tab.classList.add("is-active");


      document
        .querySelector(
          `[data-method-panel="${method}"]`
        )
        ?.classList.add("is-active");
    });
  });
</script>


<style>
