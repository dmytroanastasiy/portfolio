  transform-origin: center;

  will-change: transform;

  animation:
    synthesis-float
    5s
    ease-in-out
    infinite
    alternate;
}


/* ========================================
   INDIVIDUAL VARIATION

   Different timing + rotation prevents
   everything moving mechanically together.
======================================== */

.synthesis-source span:nth-child(1) {
  --rotate: -2deg;

  animation-duration: 5.2s;
  animation-delay: -1.2s;
}


.synthesis-source span:nth-child(2) {
  --rotate: 1.5deg;

  animation-duration: 6.3s;
  animation-delay: -3s;
}


.synthesis-source span:nth-child(3) {
  --rotate: -1deg;

  animation-duration: 5.7s;
  animation-delay: -2s;
}


.synthesis-middle span:nth-child(1) {
  --rotate: 1.5deg;

  animation-duration: 6s;
  animation-delay: -2.7s;
}


.synthesis-middle span:nth-child(2) {
  --rotate: -2deg;

  animation-duration: 5.4s;
  animation-delay: -1.5s;
}


.synthesis-middle span:nth-child(3) {
  --rotate: 2deg;

  animation-duration: 6.5s;
  animation-delay: -4s;
}


/* ========================================
   FLOAT
======================================== */

@keyframes synthesis-float {
  0% {
    transform:
      translate3d(-3px, 3px, 0)
      rotate(var(--rotate, 0deg));
