---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}works/${work.id}`} class="work-card">
  <Image src={work.data.thumbnail} alt={work.data.title} width={400} height={300} />
  <h3>{work.data.title}</h3>
  <p>{work.data.description}</p>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .work-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
