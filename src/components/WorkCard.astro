---
import { Image } from "astro:assets";

const {
  title,
  description,
  thumbnail,
  id
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<a
  class="work-card"
  href={`${base}work/${id}`}
>
  <Image
    src={thumbnail}
    alt={title}
  />

  <div class="work-card-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>