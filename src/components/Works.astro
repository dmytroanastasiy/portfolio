---
import type { ImageMetadata } from 'astro';

// Dynamically import all images from src/assets/ at build time
const globImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,webp}',
  { eager: true }
);

const works = [
  {
  title: "From Scrolling to Watching",
  category: "UX Research · Research Strategy",
  description:
    "Exploring how people move from browsing content to choosing what to watch — through secondary research, surveys, interviews and a cultural probe.",
  tags: [
    "UX Research",
    "Mixed Methods",
    "Research Synthesis"
  ],
  slug: "project-one",
},
  {
    title: "Safety Without Excessive Monitoring",
  category: "Experience Design · Speculative UX",
  description:
    "Designing a community-safety system for a generational spaceship without turning everyday life into surveillance",
  tags: [
    "Experience Design",
    "UX",
    "Prototyping",
    "Ethical Design"
  ],
  slug: "project-two",
  },
  {
  title: "Miles & Meals",
  category: "Mobile App Design · Branding",
  description:
    "A meal-box app and brand identity that turn weekly food delivery into a journey through street food, cities and local stories.",
  tags: ["UX/UI", "Branding", "Mobile App"],
  slug: "miles-and-meals",
},
];

// Helper function to resolve the bundled asset URL
function getImageUrl(imageName: string) {
  const assetPath = `/src/assets/${imageName}`;
  return globImages[assetPath] ? globImages[assetPath].default.src : '';
}
---

<section class="works" id="works">
  <div class="works-header">
    <h2 class="works-heading">Selected works</h2>
    <span class="works-tag">#works</span>
  </div>

  <div class="works-list">
    {
      works.map((item) => (
        <a
          href={`${import.meta.env.BASE_URL}work/${item.slug}`}
          class="work-row"
        >
          <div class="work-left">
            <h3 class="work-title">{item.title}</h3>
            <span class="work-category">{item.category}</span>
          </div>

          <div class="work-right">
            {item.tags.length > 0 && (
              <div class="pills">
                {item.tags.map((tag) => (
                  <span class="pill">{tag}</span>
                ))}
              </div>
            )}
            <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                d="M7 17L17 7M17 7H7M17 7V17"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .works {
    background: #ffffff;
    color: #111111;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .works-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .works-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .works-tag {
    color: #9a9a9a;
    font-size: 0.9rem;
    font-family: monospace;
  }

  .works-list {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  .work-left {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .work-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .work-category {
    font-size: 0.95rem;
    color: #888;
    font-weight: 400;
  }

  .work-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1.5rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill {
    background: #f2f2f2;
    color: #333333;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .arrow-icon {
    width: 28px;
    height: 28px;
    color: #111111;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .work-row {
      flex-direction: row;
      align-items: center;
      padding: 2.25rem 0;
    }

    .work-right {
      width: auto;
      justify-content: flex-end;
    }
  }
</style>
