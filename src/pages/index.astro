---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import About from "../components/About.astro";
import Nav from "../components/Nav.astro";
import Works from "../components/Works.astro";
import Experiments from "../components/Experiments.astro";
import Counter from "../components/Counter.jsx";

import { getCollection } from "astro:content";

const works = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL;
---
<BaseLayout pageTitle="Home">
  <Nav />
  <div class="glow-zone" id="glow-zone">
  <section class="hero" id="hero-section">
    <div class="hero-main">
     <h1 class="hero-title">
  <span class="title-line title-line--physics">
    <span class="sr-only">Dmytro</span>

    <span
      class="dmytro-physics"
      id="dmytro-physics"
      aria-hidden="true"
    >
      <img
  class="physics-letter"
  src={`${base}hero-letters/d.svg`}
  style="--w: 82"
  alt=""
  draggable="false"
/>

<img
  class="physics-letter"
  src={`${base}hero-letters/m.svg`}
  style="--w: 121"
  alt=""
  draggable="false"
/>

<img
  class="physics-letter"
  src={`${base}hero-letters/y.svg`}
  style="--w: 84"
  alt=""
  draggable="false"
/>

<img
  class="physics-letter"
  src={`${base}hero-letters/t.svg`}
  style="--w: 48"
  alt=""
  draggable="false"
/>

<img
  class="physics-letter"
  src={`${base}hero-letters/r.svg`}
  style="--w: 49"
  alt=""
  draggable="false"
/>

<img
  class="physics-letter"
  src={`${base}hero-letters/o.svg`}
  style="--w: 86"
  alt=""
  draggable="false"
/>
    </span>
  </span>

  <span class="title-line title-line--surname">
    {/* No whitespace between these spans: it would push the "A" off its edge */}
    <span data-surname><span class="sr-only">Anastasiy</span>{"Anastasiy".split("").map((char) => <span class="surname-letter" aria-hidden="true">{char}</span>)}</span>
  </span>
</h1>

      <div class="hero-description">
        <p>
          Building digital experiences
          <br />
          with clarity, character,
          <br />
          and purpose.
        </p>
      </div>
    </div>

    <div class="hero-bottom">
      <p class="hero-location">Designer / Developer</p>

      <a href="#works" class="hero-scroll" aria-label="Scroll to works section">
        <span>Explore</span>

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
        >
          <path d="M12 5V19" />
          <path d="M7 14L12 19L17 14" />
        </svg>
      </a>
    </div>

  </section>

  <Works />
  <Experiments />

  <div class="cursor-glow" aria-hidden="true"></div>
  </div>

  <About />
</BaseLayout>

<style>
  .hero {
  --mouse-x: 50%;
  --mouse-y: 50%;

  /*
    Desktop:
    roughly the upper-left cell of a 3 × 2 composition.

    Width and height are ALWAYS identical.
  */
  --physics-width: min(48vw, 45rem);
--physics-height: min(46svh, 30rem);

  position: relative;
  isolation: isolate;

  min-height: 100svh;
  width: 100%;
  overflow: hidden;

  display: flex;
  flex-direction: column;

  /* changed from space-between */
  justify-content: flex-start;

  padding:
    clamp(1.5rem, 3vw, 2.75rem)
    clamp(1.25rem, 4vw, 4.5rem);

  background: #0a0a0a;

  color: #f5f5f5;
}

  .hero-top,
  .hero-bottom {
    position: relative;
    z-index: 2;

    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    width: 100%;
  }

  .hero-eyebrow,
  .hero-year,
  .hero-location,
  .hero-scroll {
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .hero-eyebrow {
    display: flex;
    flex-direction: column;

    margin: 0;

    color: #c5c5c5;
    font-size: clamp(0.7rem, 0.8vw, 0.82rem);
    font-weight: 500;
    line-height: 1.45;

    letter-spacing: 0.14em;
    text-transform: uppercase;

    opacity: 0;
    animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  .hero-year {
    margin: 0;

    color: #656565;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;

    opacity: 0;
    animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  .hero-main {
  position: relative;
  z-index: 2;

  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: clamp(2rem, 5vw, 6rem);

  /*
    Dmytro now lives toward the upper-left
    instead of around the vertical center.
  */
  margin-top: clamp(4.5rem, 9vh, 6.5rem);
  margin-bottom: clamp(2rem, 5vh, 4rem);
}

.hero-bottom {
  margin-top: auto;
}

  .hero-title {
    margin: 0;
    margin-left: -0.06em;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: clamp(4rem, 10.8vw, 10.5rem);
    font-weight: 550;
    line-height: 0.81;

    letter-spacing: -0.075em;
  }

  .hero-title {
  margin: 0;
  margin-left: -0.06em;

  display: flex;
  flex-direction: column;

  gap: clamp(0.75rem, 2vh, 1.5rem);

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  font-size: clamp(4rem, 10.8vw, 10.5rem);
  font-weight: 550;
  line-height: 0.81;
  letter-spacing: -0.075em;
}


/* ========================================
   DMYTRO PHYSICS CELL
======================================== */

.title-line--physics {
  position: relative;
  /* Falls in front of "Anastasiy" on scroll (initDmytroFall) */
  z-index: 3;
  will-change: transform;
  display: block;

  width: var(--physics-width);
  height: var(--physics-height);
  flex: 0 0 var(--physics-height);

  overflow: hidden;

  padding: 0;
  margin: 0;

  line-height: 0;
}


/*
  This is THE Matter.js world.

  Gravity exists nowhere outside this box.
*/
.dmytro-physics {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  pointer-events: auto;
  touch-action: none;

  /*
    Needed so the edge effect stays
    visually isolated to this container.
  */
  isolation: isolate;
}


/*
  Slight blur only around the outer
  ~10px of the physics container.
*/
.dmytro-physics::after {
  content: "";

  position: absolute;
  inset: 0;

  z-index: 10;

  /*
    Starting state:
    almost the whole container is blurred.
  */
  padding: 1rem;

  pointer-events: none;

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);

  mask-composite: exclude;

  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);

  -webkit-mask-composite: xor;
}


/* .dmytro-physics.is-running::after {
  animation: physics-blur-reveal 5s
    forwards;
}


@keyframes physics-blur-reveal {
  0% {
  

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  100% {
    

    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
  } 
/* } */
.physics-letter {
  position: relative;

  display: block;

  flex: 0 0 auto;


  width: auto;
  height: 40%;

  

  object-fit: contain;

  user-select: none;
  pointer-events: auto;

  -webkit-user-drag: none;

  cursor: grab;

  transform-origin: center;
  will-change: transform;
}

.dmytro-physics.is-running {
  display: block;
}

.dmytro-physics.is-running .physics-letter {
  position: absolute;

  top: 0;
  left: 0;

  margin: 0;
}


/* ========================================
   ANASTASIY
======================================== */

.title-line--surname {
  /* Final letter spacing — the slide-in lands on this value */
  --surname-ls: -0.075em;

  display: block;

  /* Visible so the word can travel in from the left edge of the screen
     (the .hero itself clips anything outside the viewport). */
  overflow: visible;

  padding-block: 0.20em;
}


.title-line--surname {
  min-width: 0;
  contain: inline-size;
}

.title-line--surname > span {
  display: block;
  width: max-content;

  letter-spacing: var(--surname-ls);
  will-change: transform, letter-spacing;

  /* Runs at the same time the physics letters drop */
  animation:
    surname-slide
    2.4s
    cubic-bezier(0.16, 1, 0.3, 1)
    0.15s
    both;
}

/* Each letter moves on its own when the cursor pushes it (see initSurnameHover) */
.surname-letter {
  display: inline-block;
  transform-origin: 50% 85%; /* squash on the baseline */
  will-change: transform;
}

@keyframes surname-slide {
  0% {
    transform: translateX(-110vw);
    letter-spacing: 0.9em;
    opacity: 0;
  }

  12% {
    opacity: 1;
  }

  100% {
    transform: translateX(0);
    letter-spacing: var(--surname-ls);
    opacity: 1;
  }
}

@media (max-width: 800px) {
  .title-line--surname {
    --surname-ls: -0.07em;
  }
}

@media (prefers-reduced-motion: reduce) {
  .title-line--surname > span {
    animation: surname-fade 0.6s ease 0.15s both;
  }

  @keyframes surname-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
}


/* Accessibility */
.sr-only {
  position: absolute;

  width: 1px;
  height: 1px;

  padding: 0;
  margin: -1px;

  overflow: hidden;

  clip: rect(0, 0, 0, 0);
  white-space: nowrap;

  border: 0;
}

  .hero-description {
    margin-bottom: clamp(0.5rem, 1.5vw, 1.5rem);

    color: #9d9d9d;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: clamp(0.95rem, 1.3vw, 1.15rem);
    font-weight: 400;
    line-height: 1.55;

    opacity: 0;

    animation: fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  .hero-description p {
    margin: 0;
  }

  .hero-bottom {
    align-items: flex-end;

    opacity: 0;
    animation: fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
  }

  .hero-location {
    margin: 0;

    color: #626262;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    color: #d6d6d6;

    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;

    transition:
      color 250ms ease,
      transform 250ms ease;
  }

  .hero-scroll svg {
    width: 1rem;
    height: 1rem;

    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;

    transition: transform 250ms ease;
  }

  .hero-scroll:hover {
    color: #fff;
  }

  .hero-scroll:hover svg {
    transform: translateY(0.25rem);
  }

  /* ========================================
     CURSOR GLOW (hero + works + experiments)
  ======================================== */

  .glow-zone {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .cursor-glow {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;

    width: clamp(36rem, 56vw, 56rem);
    aspect-ratio: 1;

    border-radius: 50%;

    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.03) 30%,
      transparent 65%
    );

    mix-blend-mode: screen;
    pointer-events: none;

    opacity: 0;
    transform: translate3d(var(--glow-x, -100vw), var(--glow-y, -100vh), 0)
      translate(-50%, -50%);
    transition: opacity 400ms ease;
    will-change: transform;
  }

  .glow-zone.is-glowing .cursor-glow {
    opacity: 1;
  }

  @keyframes title-reveal {
    from {
      transform: translateY(115%);
    }

    to {
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

@media (max-width: 800px) {
  .hero {
    /*
      Portrait changes conceptually from
      3 × 2 to roughly 2 × 3.

      Still a perfect square.
    */
   .hero {
  --physics-width: min(48vw, 45rem);
  --physics-height: min(46svh, 30rem);


    min-height: 100svh;

    padding:
      1.5rem
      clamp(1rem, 5vw, 1.5rem)
      1.75rem;
  }

  .hero-main {
    grid-template-columns: 1fr;

    align-items: start;

    gap: 2rem;

    margin-top: 4.5rem;
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-size: clamp(4rem, 18vw, 7rem);

    line-height: 0.85;
    letter-spacing: -0.07em;

    gap: 1.25rem;
  }

  .hero-description {
    margin: 0;

    max-width: 22rem;

    font-size: 1rem;
  }

  .hero-description br {
    display: none;
  }

  .physics-letter {
    /*
      Slightly larger relative letters
      inside the smaller mobile world.
    */
    width: 15%;
  }
}

  @media (max-width: 480px) {
    .hero-year {
      display: none;
    }

    .hero-title {
      font-size: clamp(3.7rem, 18.5vw, 5.5rem);
    }

    .hero-bottom {
      gap: 1rem;
    }

    .hero-location {
      max-width: 8rem;
      line-height: 1.45;
    }
  }



  .hero,
  .hero-scroll,
  .hero-scroll svg {
    transition: none;
  }

  /*
    Physics JS deliberately doesn't start
    for reduced-motion users.

    The letters remain as normal DMYTRO.
  */
  .dmytro-physics {
    display: flex;
  }

  .physics-letter {
    position: relative;

  }
}

/* ========================================
   LETTER SIZES
   Every letter keeps its real proportions (the SVGs share one scale:
   x-height letters are shorter than d / y / t). --w is the SVG's width.
======================================== */
.hero .dmytro-physics .physics-letter {
  width: calc(var(--physics-height) * var(--w) / 308);
  height: auto;
}

@media (max-width: 800px) {
  /* Scale from the screen width so all six letters fit side by side. */
  .hero .dmytro-physics .physics-letter {
    width: calc(var(--w) * 0.155vw);
  }
}

/* ========================================
   MOBILE: physics box spans the full width
   (same side padding as the rest of the hero)
======================================== */
@media (max-width: 800px) {
  /* Keep the hero column at screen width: the surname slide-in starts with
     very wide letter-spacing and must not stretch the layout (that made the
     physics box ~1000px wide, so the letters spawned off-screen right). */
  .hero-main {
    grid-template-columns: minmax(0, 1fr);
  }

  .hero-title {
    width: 100%;
    min-width: 0;
    margin-left: 0;
  }

  .title-line--physics {
    width: 100%;
  }
}

</style>

<script>
  import Matter from "matter-js";

  /* =========================================
     HERO CURSOR GLOW
  ========================================= */

  function initHeroGlow() {
    const zone = document.querySelector("#glow-zone");

    if (
      !(zone instanceof HTMLElement) ||
      zone.dataset.glowReady === "true" ||
      !window.matchMedia("(pointer: fine)").matches
    ) {
      return;
    }

    zone.dataset.glowReady = "true";

    let frame = 0;
    let lastX = 0;
    let lastY = 0;

    function update() {
      if (frame) return;

      frame = requestAnimationFrame(() => {
        frame = 0;

        const rect = zone.getBoundingClientRect();

        zone.style.setProperty("--glow-x", `${lastX - rect.left}px`);
        zone.style.setProperty("--glow-y", `${lastY - rect.top}px`);
      });
    }

    zone.addEventListener("pointermove", (event) => {
      lastX = event.clientX;
      lastY = event.clientY;
      zone.classList.add("is-glowing");
      update();
    });

    /* keep the glow under the cursor while scrolling */
    window.addEventListener("scroll", () => {
      if (zone.classList.contains("is-glowing")) update();
    }, { passive: true });

    zone.addEventListener("pointerleave", () => {
      zone.classList.remove("is-glowing");
    });
  }


  /* =========================================
     DMYTRO PHYSICS
  ========================================= */

  /*
    Handle on the letters' Matter world, so the falling box
    (initDmytroFall) can make the letters inside feel its motion.
  */
  let dmytroWorld: {
    setFloating: (floating: boolean) => void;
    jolt: (impactSpeed: number) => void;
  } | null = null;

  async function initDmytroPhysics() {
    const container =
      document.querySelector("#dmytro-physics");

    if (!(container instanceof HTMLElement)) {
      console.warn("[Dmytro] Physics container not found.");
      return;
    }


    /*
      Prevent duplicate Matter worlds during Astro HMR.
    */
    if (container.dataset.physicsRunning === "true") {
      return;
    }


    const images = Array.from(
      container.querySelectorAll(".physics-letter")
    ).filter(
      (item) => item instanceof HTMLImageElement
    );


    if (images.length !== 6) {
      console.error(
        `[Dmytro] Expected 6 images, found ${images.length}.`
      );

      return;
    }


    /* =========================================
       WAIT FOR THE IMAGES
    ========================================= */

    await Promise.all(
      images.map(async (image) => {
        /*
          decode() works even if the image finished
          loading before this script executed.
        */
        try {
          await image.decode();
        } catch {
          /*
            decode() can reject for SVGs in some
            situations even though they're usable.
          */
        }
      })
    );


    /*
      Give the browser one frame to finish layout.
    */
    await new Promise((resolve) =>
      requestAnimationFrame(resolve)
    );


    const containerRect =
      container.getBoundingClientRect();


    if (
      containerRect.width <= 0 ||
      containerRect.height <= 0
    ) {
      console.error(
        "[Dmytro] Physics container has no size.",
        containerRect
      );

      return;
    }


    /*
      Make sure every asset actually has dimensions.
    */
    for (const image of images) {
      const rect = image.getBoundingClientRect();

      if (rect.width <= 0 || rect.height <= 0) {
        console.error(
          "[Dmytro] Letter has no dimensions:",
          image.src,
          rect
        );

        return;
      }
    }


    console.info(
      "[Dmytro] Starting Matter.js:",
      Math.round(containerRect.width),
      "×",
      Math.round(containerRect.height)
    );


    container.dataset.physicsRunning = "true";


    /* =========================================
       MATTER SETUP
    ========================================= */

    const {
      Engine,
      Runner,
      Bodies,
      Body,
      Composite,
      Mouse,
      MouseConstraint,
      Events,
      Sleeping,
    } = Matter;


    const engine = Engine.create();

    const world = engine.world;


    /*
      Same gravity as your working old project.
    */
    engine.gravity.x = 0;
    engine.gravity.y = 0.8;
    engine.gravity.scale = 0.001;


    /* =========================================
       WORLD SIZE
    ========================================= */

    let worldWidth =
      container.getBoundingClientRect().width;

    let worldHeight =
      container.getBoundingClientRect().height;


    /* =========================================
       WALLS
    ========================================= */

    const wallThickness = 500;

    let floor;
    let ceiling;
    let leftWall;
    let rightWall;


    const wallOptions = {
      isStatic: true,

      friction: 0.5,

      restitution: 0.35,

      render: {
        visible: false,
      },
    };


    function buildWalls() {
      if (floor) {
        Composite.remove(world, [
          floor,
          ceiling,
          leftWall,
          rightWall,
        ]);
      }


      worldWidth =
        container.getBoundingClientRect().width;

      worldHeight =
        container.getBoundingClientRect().height;


      floor = Bodies.rectangle(
        worldWidth / 2,
        worldHeight + wallThickness / 2,

        worldWidth + wallThickness * 2,
        wallThickness,

        wallOptions
      );


      ceiling = Bodies.rectangle(
        worldWidth / 2,
        -wallThickness / 2,

        worldWidth + wallThickness * 2,
        wallThickness,

        wallOptions
      );


      leftWall = Bodies.rectangle(
        -wallThickness / 2,
        worldHeight / 2,

        wallThickness,
        worldHeight + wallThickness * 2,

        wallOptions
      );


      rightWall = Bodies.rectangle(
        worldWidth + wallThickness / 2,
        worldHeight / 2,

        wallThickness,
        worldHeight + wallThickness * 2,

        wallOptions
      );


      Composite.add(world, [
        floor,
        ceiling,
        leftWall,
        rightWall,
      ]);
    }


    buildWalls();


    /* =========================================
       CREATE LETTER BODIES
    ========================================= */

    const initialRects =
      images.map((image) =>
        image.getBoundingClientRect()
      );


    /*
      Map a Matter body back to its IMG.
    */
    const visuals = new Map();


    const bodies = images.map(
      (image, index) => {
        const rect =
          initialRects[index];


        /*
          Spawn the letters approximately where their
          normal flex layout currently puts them.

          This gives us:

          D M Y T R O
          ↓ ↓ ↓ ↓ ↓ ↓

          and then gravity immediately takes over.
        */
        const x =
          rect.left -
          containerRect.left +
          rect.width / 2;


        const y =
          rect.top -
          containerRect.top +
          rect.height / 2;


        const body =
          Bodies.rectangle(
            x,
            y,

            rect.width,
            rect.height,

            {
              restitution: 0.55,

              friction: 0.1,

              frictionStatic: 0.15,

              frictionAir: 0.015,

              density: 0.001,

              angle:
                (Math.random() - 0.5) * 0.12,
            }
          );


        visuals.set(body, {
          element: image,

          width: rect.width,
          height: rect.height,
        });


        return body;
      }
    );


    /* =========================================
       POSITION DOM IMAGES
    ========================================= */

    function renderBodies() {
      for (const body of bodies) {
        const visual =
          visuals.get(body);

        if (!visual) continue;


        const x =
          body.position.x -
          visual.width / 2;


        const y =
          body.position.y -
          visual.height / 2;


        visual.element.style.transform =
          `translate3d(${x}px, ${y}px, 0) ` +
          `rotate(${body.angle}rad)`;
      }
    }


    /*
      Render first position before changing
      the images to absolute positioning.
    */
    renderBodies();


    /*
      CSS:
      .dmytro-physics.is-running .physics-letter {
        position: absolute;
        top: 0;
        left: 0;
      }
    */
    container.classList.add("is-running");


    Composite.add(
      world,
      bodies
    );


    /* =========================================
       MOUSE / DRAG
    ========================================= */

    const mouse =
      Mouse.create(container);


    const mouseConstraint =
      MouseConstraint.create(
        engine,
        {
          mouse,

          constraint: {
            stiffness: 0.14,

            damping: 0.08,

            render: {
              visible: false,
            },
          },
        }
      );


    Composite.add(
      world,
      mouseConstraint
    );


    /*
      Matter adds wheel listeners by default.

      Remove them so this little physics square
      doesn't steal page scrolling.
    */
    if (mouse.mousewheel) {
      mouse.element.removeEventListener(
        "mousewheel",
        mouse.mousewheel
      );

      mouse.element.removeEventListener(
        "DOMMouseScroll",
        mouse.mousewheel
      );
    }


    /* =========================================
       ENGINE -> DOM
    ========================================= */

    Events.on(
      engine,
      "afterUpdate",
      renderBodies
    );


    const runner =
      Runner.create();


    Runner.run(
      runner,
      engine
    );


    /*
      What the letters feel while their box falls:
      - floating: the box is in free fall, so the letters lose their
        weight and drift up off the floor a little
      - jolt: the box hits the ground and stops dead, so the letters
        keep going down, slam into the floor, bounce and tumble
    */
    const NORMAL_GRAVITY = engine.gravity.y;

    dmytroWorld = {
      setFloating(floating) {
        engine.gravity.y = floating ? -0.7 : NORMAL_GRAVITY;
        bodies.forEach((body) => Sleeping.set(body, false));
      },

      jolt(impactSpeed) {
        // page px/s -> Matter px per 16.7ms step, softened and capped
        const push = Math.min(22, (impactSpeed / 60) * 0.7);

        bodies.forEach((body) => {
          Sleeping.set(body, false);
          Body.setVelocity(body, {
            x: body.velocity.x + (Math.random() - 0.5) * push * 0.3,
            y: body.velocity.y + push,
          });
          Body.setAngularVelocity(
            body,
            body.angularVelocity + (Math.random() - 0.5) * push * 0.012
          );
        });
      },
    };


    /*
      A tiny initial kick makes it immediately obvious
      that physics is alive.

      Gravity itself would work without this.
    */
    bodies.forEach((body, index) => {
      Body.setVelocity(
        body,
        {
          x: (index - 2.5) * 0.08,
          y: 0.1,
        }
      );

      Sleeping.set(
        body,
        false
      );
    });


    /* =========================================
       RESPONSIVE RESIZE
    ========================================= */

    let previousWidth =
      worldWidth;

    let previousHeight =
      worldHeight;


    let resizeFrame;


    const resizeObserver =
      new ResizeObserver(() => {
        cancelAnimationFrame(
          resizeFrame
        );


        resizeFrame =
          requestAnimationFrame(() => {
            const nextRect =
              container.getBoundingClientRect();


            const nextWidth =
              nextRect.width;

            const nextHeight =
              nextRect.height;


            /*
              ResizeObserver fires once immediately.
              Ignore that first identical measurement.

              This is important: we do NOT want to
              continually zero the physics velocities.
            */
            if (
              Math.abs(nextWidth - previousWidth) < 0.5 &&
              Math.abs(nextHeight - previousHeight) < 0.5
            ) {
              return;
            }


            const scaleX =
              nextWidth / previousWidth;

            const scaleY =
              nextHeight / previousHeight;


            buildWalls();


            bodies.forEach((body) => {
              const visual =
                visuals.get(body);

              if (!visual) return;


              /*
                Reposition proportionally inside
                the new responsive square.
              */
              Body.setPosition(
                body,
                {
                  x:
                    body.position.x *
                    scaleX,

                  y:
                    body.position.y *
                    scaleY,
                }
              );


              const newLetterWidth =
                visual.element.offsetWidth;

              const newLetterHeight =
                visual.element.offsetHeight;


              if (
                newLetterWidth > 0 &&
                newLetterHeight > 0
              ) {
                const bodyScaleX =
                  newLetterWidth /
                  visual.width;

                const bodyScaleY =
                  newLetterHeight /
                  visual.height;


                Body.scale(
                  body,
                  bodyScaleX,
                  bodyScaleY
                );


                visual.width =
                  newLetterWidth;

                visual.height =
                  newLetterHeight;
              }


              /*
                Keep body center within world bounds.
              */
              const halfW =
                visual.width / 2;

              const halfH =
                visual.height / 2;


              const safeX =
                Math.max(
                  halfW,
                  Math.min(
                    nextWidth - halfW,
                    body.position.x
                  )
                );


              const safeY =
                Math.max(
                  halfH,
                  Math.min(
                    nextHeight - halfH,
                    body.position.y
                  )
                );


              Body.setPosition(
                body,
                {
                  x: safeX,
                  y: safeY,
                }
              );


              Sleeping.set(
                body,
                false
              );
            });


            previousWidth =
              nextWidth;

            previousHeight =
              nextHeight;


            renderBodies();
          });
      });


    resizeObserver.observe(
      container
    );
  }


  /* =========================================
     START
  ========================================= */

  /* =========================================
     DMYTRO BOX FALLS ON SCROLL
     The first scroll down drops the box with plain gravity. It falls
     in front of "Anastasiy", lands on the bottom edge of the black
     hero, bounces a couple of times and stays there. The letters
     inside react through dmytroWorld (see above).
  ========================================= */

  function initDmytroFall() {
    const box = document.querySelector<HTMLElement>(".title-line--physics");
    const hero = document.getElementById("hero-section");

    if (!box || !hero || box.dataset.fallReady === "true") return;
    box.dataset.fallReady = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const GRAVITY = 3200; // px/s²
    const BOUNCE = 0.28; // share of speed kept on each bounce
    const REST_SPEED = 70; // below this the box stops bouncing

    let y = 0; // current drop, px
    let speed = 0; // px/s, down is positive
    let floor = 0; // drop at which the box touches the hero's bottom edge
    let state: "waiting" | "falling" | "landed" = "waiting";
    let lastTime = 0;
    let firstImpact = true;

    // Drop needed for the box's bottom to meet the hero's bottom
    function measureFloor() {
      const heroRect = hero!.getBoundingClientRect();
      const boxRect = box!.getBoundingClientRect();
      return heroRect.bottom - (boxRect.bottom - y);
    }

    function render() {
      box!.style.transform = y ? `translate3d(0, ${y.toFixed(2)}px, 0)` : "";
    }

    function step(time: number) {
      const dt = Math.min(0.033, (time - lastTime) / 1000);
      lastTime = time;

      speed += GRAVITY * dt;
      y += speed * dt;

      if (y >= floor) {
        y = floor;
        const impact = speed;
        speed = -speed * BOUNCE;

        if (firstImpact) {
          firstImpact = false;
          dmytroWorld?.setFloating(false);
        }
        dmytroWorld?.jolt(impact);

        if (Math.abs(speed) < REST_SPEED) {
          speed = 0;
          state = "landed";
        }
      }

      render();
      if (state === "falling") requestAnimationFrame(step);
    }

    function drop() {
      if (state !== "waiting") return;
      floor = measureFloor();
      if (floor <= 1) return;

      state = "falling";
      dmytroWorld?.setFloating(true);
      lastTime = performance.now();
      requestAnimationFrame(step);
    }

    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY > 4) drop();
      },
      { passive: true }
    );

    // Page opened already scrolled down: drop straight away
    if (window.scrollY > 4) drop();

    // Keep a landed box sitting on the bottom edge if the layout changes
    new ResizeObserver(() => {
      if (state !== "landed") return;
      y = measureFloor();
      render();
    }).observe(hero);
  }

  /* =========================================
     ANASTASIY — LETTERS RUN FROM THE CURSOR
     Hovering opens a gap at the cursor: letters only move sideways,
     between two walls. The left wall is where "A" sits at rest, the right
     wall is 10rem past the "y". The 10rem of free room is shared out
     between the letter gaps, most of it to the gaps nearest the cursor.
  ========================================= */

  function initSurnameHover() {
    const word = document.querySelector<HTMLElement>("[data-surname]");

    if (
      !word ||
      word.dataset.hoverReady === "true" ||
      !window.matchMedia("(hover: hover) and (pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }

    word.dataset.hoverReady = "true";

    const letters = [...word.querySelectorAll<HTMLElement>(".surname-letter")];
    const count = letters.length;
    const offsets = new Float64Array(count);
    const velocities = new Float64Array(count);
    const targets = new Float64Array(count);
    let room = 0;

    const ROOM_REM = 10; // right wall: this far past the "y"
    const SPREAD = 0.45; // how wide the push around the cursor is, in em
    // Spring: each letter is pulled to its target and overshoots a little.
    const STIFFNESS = 160; // higher = snappier
    const DAMPING = 13; // lower = more wobble before it settles
    // Squish: letters stretch in the direction they move and flatten
    // to keep their volume, then wobble back to shape.
    const SQUISH = 0.00021; // stretch per px/s of speed
    const MAX_SQUISH = 0.154; // never wider than 1 + this
    const STEP = 1 / 120; // physics step, keeps the spring stable

    let pointer: { x: number; y: number } | null = null;
    let frame = 0;
    let lastTime = 0;

    const remPx = () =>
      parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

    function computeTargets() {
      targets.fill(0);
      if (!pointer) return;

      const box = word!.getBoundingClientRect();
      const origin = letters[0].offsetLeft;
      // Resting edges of every letter, measured from the left wall
      const edges = letters.map((l) => ({
        left: l.offsetLeft - origin,
        right: l.offsetLeft - origin + l.offsetWidth,
      }));

      room = ROOM_REM * remPx();
      const x = pointer.x - box.left;

      const sigma = parseFloat(getComputedStyle(word!).fontSize) * SPREAD;

      // A little extra on the left so coming in from that side pushes the "A"
      const inside =
        pointer.y >= box.top &&
        pointer.y <= box.bottom &&
        x >= -sigma &&
        x <= edges[count - 1].right + room;

      if (!inside) return;

      // One gap in front of every letter: the first sits between the left
      // wall and the "A", so the "A" runs right too when the cursor nears it.
      const weights: number[] = [];
      let total = 0;

      for (let i = 0; i < count; i++) {
        const seam = i === 0 ? edges[0].left : (edges[i - 1].right + edges[i].left) / 2;
        const d = (x - seam) / sigma;
        const w = Math.exp(-d * d) + 0.015; // small base so the rest breathe too
        weights.push(w);
        total += w;
      }

      // Each letter sits after every gap that opened before it,
      // so nothing passes the left wall and "y" never passes the right one.
      let shift = 0;
      for (let i = 0; i < count; i++) {
        shift += (room * weights[i]) / total;
        targets[i] = shift;
      }
    }

    function tick(time: number) {
      let dt = Math.min(0.05, (time - lastTime) / 1000 || 1 / 60);
      lastTime = time;
      const max = room || ROOM_REM * remPx();
      let moving = false;

      // Spring physics in small fixed steps
      while (dt > 0) {
        const h = Math.min(STEP, dt);
        dt -= h;
        for (let i = 0; i < count; i++) {
          const force = STIFFNESS * (targets[i] - offsets[i]) - DAMPING * velocities[i];
          velocities[i] += force * h;
          offsets[i] += velocities[i] * h;

          // Walls: bounce softly off them instead of passing
          if (offsets[i] < 0) {
            offsets[i] = 0;
            velocities[i] *= -0.35;
          } else if (offsets[i] > max) {
            offsets[i] = max;
            velocities[i] *= -0.35;
          }
        }
      }

      for (let i = 0; i < count; i++) {
        const settled =
          Math.abs(targets[i] - offsets[i]) < 0.05 && Math.abs(velocities[i]) < 0.5;

        if (settled) {
          offsets[i] = targets[i];
          velocities[i] = 0;
        } else {
          moving = true;
        }

        const stretch = Math.min(MAX_SQUISH, Math.abs(velocities[i]) * SQUISH);
        const sx = 1 + stretch;
        const sy = 1 / sx; // keep the letter's volume

        letters[i].style.transform =
          offsets[i] || stretch
            ? `translate3d(${offsets[i].toFixed(2)}px, 0, 0) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`
            : "";
      }

      frame = moving ? requestAnimationFrame(tick) : 0;
    }

    function update() {
      computeTargets();
      if (!frame) {
        lastTime = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }

    window.addEventListener(
      "pointermove",
      (event) => {
        pointer = { x: event.clientX, y: event.clientY };
        update();
      },
      { passive: true }
    );

    document.documentElement.addEventListener("pointerleave", () => {
      pointer = null;
      update();
    });

    // The word moves under a still cursor while scrolling
    window.addEventListener("scroll", update, { passive: true });
  }

  function initializeHero() {
    initHeroGlow();
    initDmytroPhysics();
    initDmytroFall();
    initSurnameHover();
  }


  /*
    Initial normal page load.
  */
  initializeHero();


  /*
    Also works if you're using Astro's
    client-side page navigation.
  */
  document.addEventListener(
    "astro:page-load",
    initializeHero
  );
</script>