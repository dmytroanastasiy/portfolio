---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import About from "../components/About.astro";
import Works from "../components/Works.astro";
import Experiments from "../components/Experiments.astro";
import Counter from "../components/Counter.jsx";
import { getCollection } from "astro:content";

const works = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout pageTitle="Home">
  <section class="hero" id="hero-section">
    <p class="hero-eyebrow">Digital Designer &amp; Developer</p>
    <h1 class="hero-title">Dmytro Anastasiy</h1>
    <p class="hero-tagline">Building &amp; shaping digital experiences.</p>
  </section>

  <About />
  <Works />
  <Experiments />
</BaseLayout>

<style>
  .hero {
    min-height: 70dvh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #0f0f0f;
    margin-top: -0.1rem;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    text-align: center;
  }

  .hero-eyebrow {
    color: #a3a3a3;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin: 0 0 1.25rem;
  }

  .hero-title {
    color: #fff;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 1.25rem;
    font-size: clamp(2.75rem, 8vw, 6.5rem);
  }

  .hero-tagline {
    color: #d1d1d1;
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 400;
    line-height: 1.4;
    max-width: 40ch;
    margin: 0;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
  }
</style>
