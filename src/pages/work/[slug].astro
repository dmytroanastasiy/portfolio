---
import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkLayout from "../../layouts/WorkLayout.astro";

import ResearchCaseStudy from "../../components/ResearchCaseStudy.astro";
import GenerationShipCaseStudy from "../../components/GenerationShipCaseStudy.astro";
import MilesAndMeals from "../../components/MilesAndMeals.astro";


export async function getStaticPaths() {
  const works = await getCollection("works");

  return works.map((work) => ({
    params: {
      slug: work.id,
    },

    props: {
      work,
    },
  }));
}


const { work } = Astro.props;

const { Content } = await render(work);


/* ==========================================
   CASE STUDY TYPES
========================================== */

const isResearchCase =
  work.data.template === "research";

const isGenerationShipCase =
  work.data.template === "generation-ship";

const isMilesAndMealsCase =
  work.data.template === "miles-and-meals";
---


{
  isResearchCase ? (

    <BaseLayout pageTitle={work.data.title}>
      <ResearchCaseStudy
        title={work.data.title}
        year={work.data.year}
        type={work.data.type}
        role={work.data.role}
        figjamUrl={work.data.figjamUrl}
      />
    </BaseLayout>

  ) : isGenerationShipCase ? (

    <BaseLayout pageTitle={work.data.title}>
      <GenerationShipCaseStudy
        title={work.data.title}
        year={work.data.year}
        type={work.data.type}
        role={work.data.role}
      />
    </BaseLayout>

  ) : isMilesAndMealsCase ? (

    <BaseLayout pageTitle={work.data.title}>
      <MilesAndMeals
        title={work.data.title}
        year={work.data.year}
        type={work.data.type}
        role={work.data.role}
      />
    </BaseLayout>

  ) : (

    <WorkLayout
      title={work.data.title}
      thumbnail={work.data.thumbnail}
    >
      <Content />
    </WorkLayout>

  )
}